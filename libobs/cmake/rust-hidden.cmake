# Generates libobs's hidden-symbol lists from rust-hidden-base.txt and the
# per-FFI-module fragments in rust-hidden.d/ (#3233):
# - rust-exports.map: ELF version script, every name `local:`;
# - rust-unexports-macos.txt: ld64 -unexported_symbols_list, `_name`.
# Windows reads neither: it exports only rust-exports.d/.
# ci/test_hidden_symbol_fragments.py runs this file with `cmake -P`.

# obs_rust_hidden_lists(<fragment dir> <base list> <out dir> <hevc>)
function(obs_rust_hidden_lists fragment_dir base out_dir hevc)
  if(CMAKE_SCRIPT_MODE_FILE)
    file(GLOB _fragments "${fragment_dir}/*.txt")
  else()
    # A new or removed fragment reconfigures.
    file(GLOB _fragments CONFIGURE_DEPENDS "${fragment_dir}/*.txt")
  endif()
  list(SORT _fragments)
  set(_map "/* Generated by libobs/cmake/rust-hidden.cmake from rust-hidden-base.txt\n")
  string(APPEND _map " * and rust-hidden.d/*.txt. Do not edit. */\n{\n  local:\n")
  set(_macos "# Generated by libobs/cmake/rust-hidden.cmake from rust-hidden-base.txt\n")
  string(APPEND _macos "# and rust-hidden.d/*.txt. Do not edit.\n")
  set(_lines)
  foreach(_file IN ITEMS "${base}" ${_fragments})
    if(NOT CMAKE_SCRIPT_MODE_FILE)
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_file}")
    endif()
    # Comment lines may hold ";", the CMake list separator: drop them first.
    file(STRINGS "${_file}" _file_lines REGEX "^[ \t]*[^# \t]")
    list(APPEND _lines ${_file_lines})
  endforeach()
  if(NOT hevc)
    # The archive contains the HEVC shims either way; the C baseline does not
    # export them when ENABLE_HEVC is off.
    list(APPEND _lines obs_hevc_keyframe obs_parse_hevc_packet obs_parse_hevc_packet_priority obs_extract_hevc_headers)
  endif()
  foreach(_line IN LISTS _lines)
    string(STRIP "${_line}" _line)
    if(_line STREQUAL "" OR _line MATCHES "^#")
      continue()
    endif()
    if(_line MATCHES "^([^ ]+) macos$")
      string(APPEND _macos "_${CMAKE_MATCH_1}\n")
    elseif(_line MATCHES "^([^ ]+) elf$")
      string(APPEND _map "    ${CMAKE_MATCH_1};\n")
    else()
      string(APPEND _map "    ${_line};\n")
      string(APPEND _macos "_${_line}\n")
    endif()
  endforeach()
  string(APPEND _map "};\n")
  file(CONFIGURE OUTPUT "${out_dir}/rust-exports.map" CONTENT "${_map}" @ONLY)
  file(CONFIGURE OUTPUT "${out_dir}/rust-unexports-macos.txt" CONTENT "${_macos}" @ONLY)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  obs_rust_hidden_lists(
    "${OBS_RUST_HIDDEN_DIR}"
    "${OBS_RUST_HIDDEN_BASE}"
    "${OBS_RUST_HIDDEN_OUT}"
    "${OBS_RUST_HIDDEN_HEVC}"
  )
endif()
