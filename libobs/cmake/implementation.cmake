# One production libobs. The C implementation is opt-in migration infrastructure.
set(OBS_LIBOBS_BACKEND HYBRID CACHE STRING "libobs implementation (HYBRID, or C for temporary rollback)")
set_property(CACHE OBS_LIBOBS_BACKEND PROPERTY STRINGS HYBRID C)
option(OBS_BUILD_C_REFERENCE "Enable the explicit, never-installed libobs-c-reference test target" OFF)
if(NOT OBS_LIBOBS_BACKEND MATCHES "^(HYBRID|C)$")
  message(FATAL_ERROR "OBS_LIBOBS_BACKEND must be HYBRID or C")
endif()

macro(obs_libobs_create_targets)
  add_library(libobs-objects OBJECT)
  set_target_properties(libobs-objects PROPERTIES POSITION_INDEPENDENT_CODE TRUE)
  add_library(libobs SHARED)
  add_library(OBS::libobs ALIAS libobs)
  set(LIBOBS_SHARED_TARGETS libobs)
  set(OBS_LIBOBS_C_TARGETS "")
  set(OBS_LIBOBS_RUST_TARGET "")
  if(OBS_LIBOBS_BACKEND STREQUAL HYBRID)
    set(OBS_LIBOBS_RUST_TARGET libobs)
    if(OBS_BUILD_C_REFERENCE)
      add_library(libobs-c-reference SHARED EXCLUDE_FROM_ALL)
      list(APPEND LIBOBS_SHARED_TARGETS libobs-c-reference)
      list(APPEND OBS_LIBOBS_C_TARGETS libobs-c-reference)
    endif()
  else()
    list(APPEND OBS_LIBOBS_C_TARGETS libobs)
  endif()
endmacro()

# All common, optional and host-specific ported source sets use this function.
function(obs_libobs_add_c_sources)
  foreach(target IN LISTS OBS_LIBOBS_C_TARGETS)
    target_sources(${target} PRIVATE ${ARGN})
  endforeach()
  # Without a C target (the default hybrid) nothing compiles these groups, so
  # their implementation files have no owner. A test that compiles one of them
  # itself (test_avc) gets its include directories from the owner
  # (cmake/common/groups.cmake): give them libobs-objects, which carries
  # libobs's usage requirements (libcaption, the libobs source dir).
  if(NOT OBS_LIBOBS_C_TARGETS)
    foreach(source IN LISTS ARGN)
      if(_OBS_GROUP_REGEX AND source MATCHES "${_OBS_GROUP_REGEX}")
        cmake_path(ABSOLUTE_PATH source BASE_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}" NORMALIZE OUTPUT_VARIABLE group)
        _obs_group_read("${group}" _pch members)
        foreach(member IN LISTS members)
          set_property(GLOBAL PROPERTY "_OBS_IMPL_OWNER:${member}" libobs-objects)
        endforeach()
      endif()
    endforeach()
  endif()
endfunction()
