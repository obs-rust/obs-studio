autoload -Uz log_debug

# zccache is the compiler launcher of the ubuntu-ci preset. Install the
# pinned release (checksum-verified) and point it at the cache dir CI
# restores and saves.
local zccache_bin=${HOME}/.local/bin
uv run --no-project ${project_root}/rust/tools/linux-validate/install_zccache.py ${zccache_bin}
path=(${zccache_bin} ${path})
if [[ -n ${GITHUB_PATH} ]] print ${zccache_bin} >> ${GITHUB_PATH}

typeset -gx ZCCACHE_CACHE_DIR=${ZCCACHE_CACHE_DIR:-${GITHUB_WORKSPACE:-${HOME}}/.zccache}
log_debug "zccache cache dir: ${ZCCACHE_CACHE_DIR}"
