# Fails when libobs.so calls one of its own exported functions through the
# PLT (#3220). Run by the libobs_local_binding test (tests.d).
execute_process(COMMAND "${NM}" -D --defined-only "${LIBRARY}" OUTPUT_VARIABLE defined COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${READELF}" -rW "${LIBRARY}" OUTPUT_VARIABLE relocations COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCHALL "[0-9a-f]+ [TW] [A-Za-z_][A-Za-z0-9_]*" defined "${defined}")
set(names "")
foreach(line IN LISTS defined)
  string(REGEX REPLACE "^.* " "" name "${line}")
  list(APPEND names "${name}")
endforeach()
string(REGEX MATCHALL "JUMP_SLOT[^\n]*" slots "${relocations}")
set(local "")
foreach(slot IN LISTS slots)
  if(slot MATCHES " ([A-Za-z_][A-Za-z0-9_]*)(@[^ ]*)? \\+ [0-9a-f]+$")
    if(CMAKE_MATCH_1 IN_LIST names)
      list(APPEND local "${CMAKE_MATCH_1}")
    endif()
  endif()
endforeach()
list(LENGTH local count)
if(count GREATER 0)
  list(SUBLIST local 0 10 sample)
  message(FATAL_ERROR "libobs.so calls ${count} of its own functions through the PLT, e.g. ${sample}")
endif()
message(STATUS "libobs.so binds its own calls locally")
