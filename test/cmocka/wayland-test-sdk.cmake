include_guard(DIRECTORY)
set(HAVE_WAYLAND_CLIENT_TEST_SDK FALSE)
set(HAVE_WAYLAND_SERVER_TEST_SDK FALSE)
if((OS_LINUX OR OS_FREEBSD) AND ENABLE_WAYLAND)
  find_package(Wayland QUIET COMPONENTS Client)
  find_package(Xkbcommon QUIET)
  if(TARGET Wayland::Client AND TARGET xkbcommon::xkbcommon)
    set(HAVE_WAYLAND_CLIENT_TEST_SDK TRUE)
  endif()
  find_package(Wayland QUIET COMPONENTS Client Server)
  if(TARGET Wayland::Client AND TARGET Wayland::Server AND TARGET xkbcommon::xkbcommon)
    set(HAVE_WAYLAND_SERVER_TEST_SDK TRUE)
  endif()
endif()
