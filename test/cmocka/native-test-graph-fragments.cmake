# Deterministic per-target assembly. Single documents are only fixture inputs.
include_guard(GLOBAL)

function(obs_read_test_graph output path)
  if(NOT IS_DIRECTORY "${path}")
    file(READ "${path}" graph)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    set(${output} "${graph}" PARENT_SCOPE)
    return()
  endif()
  if(CMAKE_SCRIPT_MODE_FILE)
    file(GLOB fragments "${path}/*.json")
  else()
    file(GLOB fragments CONFIGURE_DEPENDS "${path}/*.json")
  endif()
  list(SORT fragments)
  if(NOT fragments)
    message(FATAL_ERROR "Empty native test graph directory: ${path}")
  endif()
  set(targets "")
  set(tests "")
  set(test_names)
  foreach(fragment IN LISTS fragments)
    file(READ "${fragment}" value)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${fragment}")
    get_filename_component(owner "${fragment}" NAME_WE)
    string(JSON fields LENGTH "${value}")
    string(JSON schema GET "${value}" schema)
    string(JSON target_kind TYPE "${value}" targets)
    string(JSON target_count LENGTH "${value}" targets)
    string(JSON test_kind TYPE "${value}" tests)
    if(
      NOT fields EQUAL 3
      OR NOT schema EQUAL 1
      OR NOT target_kind STREQUAL "OBJECT"
      OR NOT target_count EQUAL 1
      OR NOT test_kind STREQUAL "OBJECT"
    )
      message(FATAL_ERROR "Invalid native test graph fragment: ${fragment}")
    endif()
    string(JSON name MEMBER "${value}" targets 0)
    if(NOT name STREQUAL owner)
      message(FATAL_ERROR "Native test fragment must own target ${owner}: ${fragment}")
    endif()
    string(JSON entry GET "${value}" targets "${name}")
    if(NOT targets STREQUAL "")
      string(APPEND targets ",")
    endif()
    string(APPEND targets "\"${name}\":${entry}")
    string(JSON count LENGTH "${value}" tests)
    if(count GREATER 0)
      math(EXPR last "${count} - 1")
      foreach(index RANGE ${last})
        string(JSON name MEMBER "${value}" tests ${index})
        string(JSON target GET "${value}" tests "${name}" target)
        if(NOT target STREQUAL owner OR name IN_LIST test_names)
          message(FATAL_ERROR "Duplicate native test or wrong owner: ${name} in ${fragment}")
        endif()
        list(APPEND test_names "${name}")
        string(JSON entry GET "${value}" tests "${name}")
        if(NOT tests STREQUAL "")
          string(APPEND tests ",")
        endif()
        string(APPEND tests "\"${name}\":${entry}")
      endforeach()
    endif()
  endforeach()
  set(${output} "{\"schema\":1,\"targets\":{${targets}},\"tests\":{${tests}}}" PARENT_SCOPE)
endfunction()
