# Explicit C unity partitions shared with obs-build. Keeping callers separate
# from definitions preserves GNU ld --wrap's undefined-reference boundary.
function(_obs_test_graph_groups target graph root sources)
  string(JSON kind ERROR_VARIABLE error TYPE "${graph}" targets "${target}" unity_groups)
  if(error)
    return()
  endif()
  if(NOT kind STREQUAL "OBJECT")
    message(FATAL_ERROR "Native test unity_groups must be an object")
  endif()
  string(JSON header GET "${graph}" targets "${target}" pch)
  if(header MATCHES "(^/|\\\\|:|;|\n|\r|\"|(^|/)\\.\\.?(/|$))" OR NOT header MATCHES "\\.h$")
    message(FATAL_ERROR "Invalid native test unity PCH ${header}")
  endif()
  string(JSON count LENGTH "${graph}" targets "${target}" unity_groups)
  if(count LESS 1)
    message(FATAL_ERROR "Native test unity groups must not be empty")
  endif()
  math(EXPR last "${count} - 1")
  set(inputs)
  set(members)
  foreach(index RANGE ${last})
    string(JSON group MEMBER "${graph}" targets "${target}" unity_groups ${index})
    if(NOT group MATCHES "^[A-Za-z0-9_-]+$")
      message(FATAL_ERROR "Invalid native test unity group ${group}")
    endif()
    _obs_test_graph_array(paths "${graph}" targets "${target}" unity_groups "${group}")
    if(NOT paths)
      message(FATAL_ERROR "Empty native test unity group ${group}")
    endif()
    set(content "#include \"${root}/${header}\"\n")
    foreach(path IN LISTS paths)
      if(NOT path IN_LIST sources OR path IN_LIST members OR NOT path MATCHES "\\.c(\\.h)?$")
        message(FATAL_ERROR "Invalid or duplicate native test unity member ${path}")
      endif()
      list(APPEND members "${path}")
      string(APPEND content "#include \"${root}/${path}\"\n")
    endforeach()
    set(output "${CMAKE_CURRENT_BINARY_DIR}/native-tests/${target}/${group}.c")
    file(GENERATE OUTPUT "${output}" CONTENT "${content}")
    set_source_files_properties("${output}" TARGET_DIRECTORY ${target} PROPERTIES UNITY_GROUP "${group}")
    list(APPEND inputs "${output}")
  endforeach()
  list(SORT sources)
  list(SORT members)
  if(NOT members STREQUAL sources)
    message(FATAL_ERROR "Native test unity groups must partition all C sources")
  endif()
  set_property(TARGET ${target} PROPERTY SOURCES "${inputs}")
  set_target_properties(${target} PROPERTIES UNITY_BUILD ON UNITY_BUILD_MODE GROUP)
  target_precompile_headers(${target} PRIVATE "${root}/${header}")
endfunction()
