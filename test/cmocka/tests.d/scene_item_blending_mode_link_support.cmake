# Standalone Rust archive consumers need the live private atomic adapter too.
function(_scene_item_blending_mode_link_support)
  get_directory_property(_targets BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_links ${_target} LINK_LIBRARIES)
    if(_target MATCHES "^test_scene" AND "libobs_rust-static" IN_LIST _links)
      get_target_property(_sources ${_target} SOURCES)
      set(_adapter "${CMAKE_CURRENT_SOURCE_DIR}/scene-item-blending-mode-link-support.c")
      if(NOT _adapter IN_LIST _sources)
        target_sources(${_target} PRIVATE "${_adapter}")
        target_include_directories(${_target} PRIVATE "${CMAKE_SOURCE_DIR}/libobs")
        target_link_libraries(${_target} PRIVATE "$<$<PLATFORM_ID:Windows>:OBS::w32-pthreads>")
      endif()
    endif()
  endforeach()
endfunction()
cmake_language(DEFER CALL _scene_item_blending_mode_link_support)
