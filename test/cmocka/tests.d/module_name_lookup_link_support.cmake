# Unrelated standalone Rust archive consumers do not own module registries.
function(_module_name_lookup_link_support)
  get_directory_property(_targets BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_links ${_target} LINK_LIBRARIES)
    if("libobs_rust-static" IN_LIST _links)
      get_target_property(_sources ${_target} SOURCES)
      set(_stub "${CMAKE_CURRENT_SOURCE_DIR}/module-name-lookup-link-stubs.c")
      if(NOT _stub IN_LIST _sources)
        target_sources(${_target} PRIVATE "${_stub}")
      endif()
    endif()
  endforeach()
endfunction()
cmake_language(DEFER CALL _module_name_lookup_link_support)
