# Standalone scene-rule tests link Rust without the private production adapters.
function(_scene_source_getter_link_support)
  get_directory_property(_targets BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_links ${_target} LINK_LIBRARIES)
    if(_target MATCHES "^test_scene" AND "libobs_rust-static" IN_LIST _links)
      get_target_property(_sources ${_target} SOURCES)
      if(_target STREQUAL "test_scene_item_crop_rust")
        set(_stub "${CMAKE_CURRENT_SOURCE_DIR}/scene-source-getter-link-support.c")
      else()
        set(_stub "${CMAKE_CURRENT_SOURCE_DIR}/scene-source-getter-link-stubs.c")
      endif()
      if(NOT _stub IN_LIST _sources)
        target_sources(${_target} PRIVATE "${_stub}")
      endif()
      target_include_directories(${_target} PRIVATE "${CMAKE_SOURCE_DIR}/libobs")
    endif()
  endforeach()
endfunction()
cmake_language(DEFER CALL _scene_source_getter_link_support)
