# Standalone users may pull this adapter through obs-core archive members.
function(_video_scale_effects_link_support)
  get_directory_property(_targets BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_links ${_target} LINK_LIBRARIES)
    if("libobs_rust-static" IN_LIST _links)
      target_sources(${_target} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/video-scale-effects-link-support.c")
      target_include_directories(${_target} PRIVATE "${CMAKE_SOURCE_DIR}" "${CMAKE_SOURCE_DIR}/libobs" "${CMAKE_BINARY_DIR}/config")
      target_link_libraries(${_target} PRIVATE OBS::caption Uthash::Uthash SIMDe::SIMDe "$<$<PLATFORM_ID:Windows>:OBS::w32-pthreads>")
    endif()
  endforeach()
endfunction()
cmake_language(DEFER CALL _video_scale_effects_link_support)
