# Actual-library API characterization; reuse the loader's existing Linux fixture.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND TARGET core_module_stub)
  add_executable(test_source_module test_source_module.c)
  target_include_directories(test_source_module PRIVATE ${CMOCKA_INCLUDE_DIR})
  target_compile_definitions(test_source_module PRIVATE CORE_STUB_PATH="$<TARGET_FILE:core_module_stub>")
  target_link_libraries(test_source_module PRIVATE OBS::libobs OBS::caption Uthash::Uthash ${CMOCKA_LIBRARIES})
  if(TARGET OBS::w32-pthreads)
    target_link_libraries(test_source_module PRIVATE OBS::w32-pthreads)
  endif()
  add_dependencies(test_source_module core_module_stub)
  add_dependencies(cmocka-tests test_source_module)
  add_test(NAME test_source_module COMMAND test_source_module)
  set_tests_properties(test_source_module PROPERTIES TIMEOUT 30)
endif()
