# Direct public main-canvas getter characterization, shared by both libobs builds.
add_executable(test_get_main_canvas test_get_main_canvas.c)
target_include_directories(test_get_main_canvas PRIVATE ${CMOCKA_INCLUDE_DIR})
target_link_libraries(test_get_main_canvas PRIVATE OBS::libobs OBS::caption Uthash::Uthash ${CMOCKA_LIBRARIES})
if(TARGET OBS::w32-pthreads)
  target_link_libraries(test_get_main_canvas PRIVATE OBS::w32-pthreads)
endif()
add_dependencies(cmocka-tests test_get_main_canvas)
if(OS_LINUX AND OBS_XVFB_RUN_REAL)
  add_test(NAME test_get_main_canvas COMMAND "${XVFB_RUN}" -a $<TARGET_FILE:test_get_main_canvas>)
else()
  add_test(NAME test_get_main_canvas COMMAND test_get_main_canvas)
endif()
set_tests_properties(test_get_main_canvas PROPERTIES TIMEOUT 30 SKIP_RETURN_CODE 77)
