# Real scene callback through the public C API; needs the OpenGL video backend.
if(OS_LINUX AND TARGET OBS::libobs-opengl)
  add_executable(test_scene_color_space test_scene_color_space.c)
  target_compile_definitions(test_scene_color_space PRIVATE GRAPHICS_MODULE_PATH="$<TARGET_FILE:OBS::libobs-opengl>")
  target_include_directories(test_scene_color_space PRIVATE ${CMOCKA_INCLUDE_DIR})
  target_link_libraries(test_scene_color_space PRIVATE OBS::libobs ${CMOCKA_LIBRARIES})
  add_dependencies(test_scene_color_space libobs-opengl)
  add_dependencies(cmocka-tests test_scene_color_space)
  add_test(NAME test_scene_color_space COMMAND test_scene_color_space WORKING_DIRECTORY "${OBS_OUTPUT_DIR}/$<CONFIG>")
  set_tests_properties(test_scene_color_space PROPERTIES TIMEOUT 60)
