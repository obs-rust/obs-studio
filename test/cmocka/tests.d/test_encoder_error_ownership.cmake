# The private duplicate helper is hidden: characterize its real C body only.
set(_encoder_error_source "${CMAKE_SOURCE_DIR}/libobs/obs-encoder-error-ownership.c.h")
if(NOT EXISTS "${_encoder_error_source}")
  set(_encoder_error_source "${CMAKE_SOURCE_DIR}/libobs/obs-encoder.c.h")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_encoder_error_source}")
file(READ "${_encoder_error_source}" _encoder_error_text)
string(FIND "${_encoder_error_text}" "char *obs_encoder_dup_last_error(obs_encoder_t *encoder)\n{" _encoder_error_start)
if(_encoder_error_start LESS 0)
  message(FATAL_ERROR "Cannot locate obs_encoder_dup_last_error")
endif()
string(SUBSTRING "${_encoder_error_text}" ${_encoder_error_start} -1 _encoder_error_tail)
string(FIND "${_encoder_error_tail}" "\n}\n" _encoder_error_end)
if(_encoder_error_end LESS 0)
  message(FATAL_ERROR "Cannot locate end of obs_encoder_dup_last_error")
endif()
math(EXPR _encoder_error_length "${_encoder_error_end} + 3")
string(SUBSTRING "${_encoder_error_tail}" 0 ${_encoder_error_length} _encoder_error_body)
string(REPLACE "obs_encoder_dup_last_error" "encoder_error_ownership_dup" _encoder_error_body "${_encoder_error_body}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/encoder-error-ownership-dup.h" "static ${_encoder_error_body}")
add_executable(test_encoder_error_ownership test_encoder_error_ownership.c)
target_include_directories(test_encoder_error_ownership PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
target_link_libraries(
  test_encoder_error_ownership
  PRIVATE OBS::libobs OBS::caption Uthash::Uthash OBS::native-test-cmocka
)
if(OS_WINDOWS)
  target_link_libraries(test_encoder_error_ownership PRIVATE OBS::w32-pthreads)
endif()
add_dependencies(cmocka-tests test_encoder_error_ownership)
add_test(NAME test_encoder_error_ownership COMMAND test_encoder_error_ownership)
set_tests_properties(test_encoder_error_ownership PROPERTIES TIMEOUT 10)
