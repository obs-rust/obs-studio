# Install synthetic records inside each actual library's hidden core, without
# startup, plugin loading or graphics. No test implementation of the entry point.
if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
  foreach(_post_load_library IN ITEMS libobs libobs-c-reference)
    if(TARGET ${_post_load_library})
      target_sources(${_post_load_library} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../module_post_load_fixture.c")
      target_link_libraries(${_post_load_library} PRIVATE OBS::caption Uthash::Uthash)
      if(TARGET OBS::w32-pthreads)
        target_link_libraries(${_post_load_library} PRIVATE OBS::w32-pthreads)
      endif()
    endif()
  endforeach()
  add_executable(test_module_post_load test_module_post_load.c)
  target_include_directories(test_module_post_load PRIVATE ${CMOCKA_INCLUDE_DIR})
  target_link_libraries(test_module_post_load PRIVATE OBS::libobs OBS::caption Uthash::Uthash ${CMOCKA_LIBRARIES})
  if(TARGET OBS::w32-pthreads)
    target_link_libraries(test_module_post_load PRIVATE OBS::w32-pthreads)
  endif()
  add_dependencies(cmocka-tests test_module_post_load)
  add_test(NAME test_module_post_load COMMAND test_module_post_load)
  set_tests_properties(test_module_post_load PROPERTIES TIMEOUT 30)
endif()
