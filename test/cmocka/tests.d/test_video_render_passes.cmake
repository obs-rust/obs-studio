# Private C-source characterization: execute the production bodies with a
# recording graphics double, without a display or GPU. This does not test a
# future Rust swap until its symbols are made reachable by the port.
set(_video_passes_root "${CMAKE_CURRENT_LIST_DIR}/../../..")
set(_video_passes_source "${_video_passes_root}/libobs/obs-video-render-passes.c.h")
if(NOT EXISTS "${_video_passes_source}")
  set(_video_passes_source "${_video_passes_root}/libobs/obs-video.c.h")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_video_passes_source}")
file(READ "${_video_passes_source}" _video_passes_text)
set(_video_passes_bodies "")
foreach(_signature IN ITEMS "static inline void draw_mix_texture(" "static void render_convert_plane(")
  string(FIND "${_video_passes_text}" "${_signature}" _start)
  if(_start LESS 0)
    message(FATAL_ERROR "Cannot locate video render helper: ${_signature}")
  endif()
  string(SUBSTRING "${_video_passes_text}" ${_start} -1 _tail)
  string(FIND "${_tail}" "\n}" _end)
  if(_end LESS 0)
    message(FATAL_ERROR "Cannot locate end of video render helper: ${_signature}")
  endif()
  math(EXPR _length "${_end} + 2")
  string(SUBSTRING "${_tail}" 0 ${_length} _body)
  string(APPEND _video_passes_bodies "${_body}\n\n")
endforeach()
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/video-render-passes-under-test.h" "${_video_passes_bodies}")

add_executable(test_video_render_passes "${CMAKE_CURRENT_LIST_DIR}/../test_video_render_passes.c")
target_include_directories(test_video_render_passes PRIVATE "${CMAKE_CURRENT_BINARY_DIR}" ${CMOCKA_INCLUDE_DIR})
target_link_libraries(test_video_render_passes PRIVATE ${CMOCKA_LIBRARIES})
add_dependencies(cmocka-tests test_video_render_passes)
add_test(NAME test_video_render_passes COMMAND test_video_render_passes)
obs_test_sanitize(test_video_render_passes "address,undefined")
