# Retain the real field operations for Rust-static scene consumers.
function(_scene_item_set_visibility_link_support)
  get_directory_property(_targets BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    get_target_property(_links ${_target} LINK_LIBRARIES)
    if(_target MATCHES "^test_scene" AND "libobs_rust-static" IN_LIST _links)
      target_sources(${_target} PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/scene-item-set-visibility-link-support.c")
      target_include_directories(${_target} PRIVATE "${CMAKE_SOURCE_DIR}" "${CMAKE_SOURCE_DIR}/libobs")
      target_link_libraries(${_target} PRIVATE "$<$<PLATFORM_ID:Windows>:OBS::w32-pthreads>")
    endif()
  endforeach()
endfunction()
cmake_language(DEFER CALL _scene_item_set_visibility_link_support)
