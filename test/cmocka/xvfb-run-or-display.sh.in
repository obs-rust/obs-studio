#!/bin/sh
# Stand-in for xvfb-run in the cmocka tests' add_test commands (configured by
# test/cmocka/CMakeLists.txt): run the test on the X display it already has
# (validate.sh runs all of ctest under one xvfb-run), and start a private
# Xvfb only when there is none. Each test starting its own `xvfb-run -a`
# raced the others for a display number under ctest -j: two at once picked
# the same one, and the loser's obs_startup failed with "Unable to open X
# display".
#   xvfb-run-or-display [xvfb-run options] <command> [args...]
if [ -z "${DISPLAY:-}" ]; then
  # The private server always runs with -noreset. Without it Xvfb resets when
  # its last client disconnects: a test that starts and shuts down libobs once
  # per case closes the only X connection each time, and the next case's
  # XOpenDisplay can lose the race with that reset (obs_startup fails, cmocka
  # reports "Test setup failed"). validate.sh's shared display does the same.
  noreset() {
    case " $1 " in
    *" -noreset "*) printf '%s' "$1" ;;
    *) printf '%s' "$1 -noreset" ;;
    esac
  }
  server_args=
  command=
  # Rebuild the arguments in place: each one is taken off the front and put
  # back at the end, with -noreset added to the server arguments.
  n=$#
  while [ "$n" -gt 0 ]; do
    arg=$1
    shift
    n=$((n - 1))
    if [ -z "$command" ]; then
      case "$arg" in
      -s | --server-args)
        set -- "$@" "$arg" "$(noreset "$1")"
        shift
        n=$((n - 1))
        server_args=1
        continue
        ;;
      --server-args=*)
        set -- "$@" "--server-args=$(noreset "${arg#--server-args=}")"
        server_args=1
        continue
        ;;
      -e | -f | -n | -p | -w | --error-file | --auth-file | --server-num | --xauth-protocol | --wait)
        set -- "$@" "$arg" "$1"
        shift
        n=$((n - 1))
        continue
        ;;
      -a | --auto-servernum | -l | --listen-tcp | --*=*) ;;
      *)
        # "--" or the test command: xvfb-run's options end here.
        command=1
        [ -n "$server_args" ] || set -- "$@" -s "-screen 0 1280x1024x24 -noreset"
        ;;
      esac
    fi
    set -- "$@" "$arg"
  done
  exec "@OBS_XVFB_RUN_REAL@" "$@"
fi
# xvfb-run's own options (they configure the server we don't start).
while [ $# -gt 0 ]; do
  case "$1" in
  -a | --auto-servernum | -l | --listen-tcp) shift ;;
  -e | -f | -n | -p | -s | -w) shift 2 ;;
  --error-file | --auth-file | --server-num | --xauth-protocol | --server-args | --wait) shift 2 ;;
  --*=*) shift ;;
  --) shift; break ;;
  *) break ;;
  esac
done
exec "$@"
