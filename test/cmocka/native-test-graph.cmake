# Consumer of the native test graph shared with obs-build. Paths in the graph
# are repository-relative; runtime substitutions are deliberately limited.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/qt-runtime.cmake")

function(_obs_test_graph_fields json path allowed)
  string(JSON kind TYPE "${json}" ${path})
  if(NOT kind STREQUAL "OBJECT")
    message(FATAL_ERROR "Native test graph ${path} must be an object")
  endif()
  string(JSON count LENGTH "${json}" ${path})
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON field MEMBER "${json}" ${path} ${index})
      if(NOT field IN_LIST allowed)
        message(FATAL_ERROR "Unknown native test graph field ${path}/${field}")
      endif()
    endforeach()
  endif()
endfunction()

function(_obs_test_graph_array output json)
  string(JSON kind ERROR_VARIABLE error TYPE "${json}" ${ARGN})
  if(error)
    set(${output} "" PARENT_SCOPE)
    return()
  endif()
  if(NOT kind STREQUAL "ARRAY")
    message(FATAL_ERROR "Native test graph field ${ARGN} must be an array")
  endif()
  set(values)
  string(JSON count LENGTH "${json}" ${ARGN})
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON kind TYPE "${json}" ${ARGN} ${index})
      if(NOT kind STREQUAL "STRING")
        message(FATAL_ERROR "Native test graph ${ARGN} entries must be strings")
      endif()
      string(JSON value GET "${json}" ${ARGN} ${index})
      string(REPLACE ";" "\\;" value "${value}")
      list(APPEND values "${value}")
    endforeach()
  endif()
  set(${output} "${values}" PARENT_SCOPE)
endfunction()

function(_obs_test_graph_requirement output json)
  string(JSON kind ERROR_VARIABLE error TYPE "${json}" ${ARGN})
  if(error)
    set(${output} TRUE PARENT_SCOPE)
    return()
  endif()
  string(JSON value GET "${json}" ${ARGN})
  if(kind STREQUAL "BOOLEAN")
    set(${output} "${value}" PARENT_SCOPE)
  elseif(kind STREQUAL "STRING")
    # CMake defines these built-in platform/compiler facts only when true.
    # Wayland and the X11 display declaration may be absent on other hosts.
    # SDK facts stay explicitly declared; unknown names (including typos) fail.
    set(
      platform_facts
      UNIX
      APPLE
      WIN32
      MSVC
      OS_LINUX
      OS_FREEBSD
      OS_OPENBSD
      OS_WINDOWS
      OS_MACOS
    )
    set(
      host_options
      ENABLE_WAYLAND
      HAVE_X11_DISPLAY
      HAVE_QT_CORE_TEST_OWNER
      HAVE_CRASH_LOG_TEST_OWNER
      HAVE_QT_WIDGETS_TEST_OWNER
      HAVE_QT_WIDGETS_TESTLIB_OWNER
      HAVE_PLUGIN_MANAGER_TEST_OWNER
      HAVE_VST_EDITOR_TEST_OWNER
      HAVE_PRIVATE_DAEMON_TEST_OWNER
      HAVE_PIPEWIRE_CAMERA_TEST_OWNER
      HAVE_V4L2_VMIC_TEST_OWNER
    )
    if(NOT DEFINED ${value} AND NOT value IN_LIST platform_facts AND NOT value IN_LIST host_options)
      message(FATAL_ERROR "Unknown native test requirement ${value}")
    endif()
    if(${value})
      set(${output} TRUE PARENT_SCOPE)
    else()
      set(${output} FALSE PARENT_SCOPE)
    endif()
  elseif(kind STREQUAL "OBJECT")
    string(JSON count LENGTH "${json}" ${ARGN})
    if(NOT count EQUAL 1)
      message(FATAL_ERROR "Native test requirement must have exactly one operator")
    endif()
    string(JSON operator MEMBER "${json}" ${ARGN} 0)
    if(operator STREQUAL "not")
      _obs_test_graph_requirement(selected "${json}" ${ARGN} not)
      if(selected)
        set(selected FALSE)
      else()
        set(selected TRUE)
      endif()
    elseif(operator STREQUAL "all" OR operator STREQUAL "any")
      string(JSON kind TYPE "${json}" ${ARGN} ${operator})
      if(NOT kind STREQUAL "ARRAY")
        message(FATAL_ERROR "Native test requirement ${operator} must be an array")
      endif()
      string(JSON count LENGTH "${json}" ${ARGN} ${operator})
      if(operator STREQUAL "all")
        set(selected TRUE)
      else()
        set(selected FALSE)
      endif()
      if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
          _obs_test_graph_requirement(child "${json}" ${ARGN} ${operator} ${index})
          if(operator STREQUAL "all" AND NOT child)
            set(selected FALSE)
          elseif(operator STREQUAL "any" AND child)
            set(selected TRUE)
          endif()
        endforeach()
      endif()
    else()
      message(FATAL_ERROR "Unknown native test requirement operator ${operator}")
    endif()
    set(${output} "${selected}" PARENT_SCOPE)
  else()
    message(FATAL_ERROR "Invalid native test requirement ${ARGN}")
  endif()
endfunction()

function(_obs_test_graph_expand output value root target)
  string(REPLACE "\${source}" "${root}" value "${value}")
  string(REPLACE "\${build}" "${CMAKE_CURRENT_BINARY_DIR}" value "${value}")
  if(value MATCHES "\\$\\{runtime\\}")
    if(DEFINED OBS_OUTPUT_DIR)
      set(runtime "${OBS_OUTPUT_DIR}/$<CONFIG>")
    elseif(OS_MACOS OR OS_WINDOWS)
      # Portable startup tests originally used CTest's default working directory.
      # macOS has no rundir, and standalone host configurations may omit it too.
      set(runtime "${CMAKE_CURRENT_BINARY_DIR}")
    else()
      message(FATAL_ERROR "Native test runtime directory OBS_OUTPUT_DIR is missing")
    endif()
    string(REPLACE "\${runtime}" "${runtime}" value "${value}")
  endif()
  string(REPLACE "\${target}" "$<TARGET_FILE:${target}>" value "${value}")
  if(value MATCHES "\\$\\{")
    message(FATAL_ERROR "Unknown native test template ${value}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(_obs_test_graph_sources output graph target)
  string(JSON count LENGTH "${graph}" targets "${target}" sources)
  set(sources)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON kind TYPE "${graph}" targets "${target}" sources ${index})
      if(kind STREQUAL "STRING")
        string(JSON path GET "${graph}" targets "${target}" sources ${index})
        set(selected TRUE)
      elseif(kind STREQUAL "OBJECT")
        _obs_test_graph_fields("${graph}" "targets;${target};sources;${index}" "path;requires")
        string(
          JSON path_kind
          TYPE "${graph}"
          targets
          "${target}"
          sources
          ${index}
          path
        )
        if(NOT path_kind STREQUAL "STRING")
          message(FATAL_ERROR "Invalid native test source path for ${target}")
        endif()
        string(
          JSON path
          GET "${graph}"
          targets
          "${target}"
          sources
          ${index}
          path
        )
        # A conditional source must explicitly declare its requirement.
        string(
          JSON requirement_kind
          TYPE "${graph}"
          targets
          "${target}"
          sources
          ${index}
          requires
        )
        _obs_test_graph_requirement(selected "${graph}" targets "${target}" sources ${index} requires)
      else()
        message(FATAL_ERROR "Invalid native test source for ${target}")
      endif()
      if(path STREQUAL "")
        message(FATAL_ERROR "Empty native test source path for ${target}")
      endif()
      if(selected)
        list(APPEND sources "${path}")
      endif()
    endforeach()
  endif()
  if(NOT sources)
    message(FATAL_ERROR "Native test target ${target} has no selected sources")
  endif()
  set(${output} "${sources}" PARENT_SCOPE)
endfunction()

function(_obs_test_graph_values output graph target field)
  string(JSON count ERROR_VARIABLE error LENGTH "${graph}" targets "${target}" ${field})
  set(values)
  if(NOT error AND count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON kind TYPE "${graph}" targets "${target}" ${field} ${index})
      if(kind STREQUAL "STRING")
        string(JSON name GET "${graph}" targets "${target}" ${field} ${index})
      elseif(kind STREQUAL "OBJECT")
        _obs_test_graph_fields("${graph}" "targets;${target};${field};${index}" "name;requires")
        _obs_test_graph_requirement(selected "${graph}" targets "${target}" ${field} ${index} requires)
        if(NOT selected)
          continue()
        endif()
        string(
          JSON name
          GET "${graph}"
          targets
          "${target}"
          ${field}
          ${index}
          name
        )
      else()
        message(FATAL_ERROR "Invalid native test ${field} for ${target}")
      endif()
      list(APPEND values "${name}")
    endforeach()
  endif()
  set(${output} "${values}" PARENT_SCOPE)
endfunction()

# No declared X server is a supported exclusion. The project declares its
# Xvfb runner at configure time and starts that server later, before CTest.
function(_obs_test_graph_x11_display output)
  if(DEFINED HAVE_X11_DISPLAY)
    set(${output} "${HAVE_X11_DISPLAY}" PARENT_SCOPE)
    return()
  endif()
  set(available FALSE)
  if(OS_LINUX)
    if(NOT "$ENV{DISPLAY}" STREQUAL "" OR OBS_XVFB_RUN_REAL OR XVFB_RUN)
      set(available TRUE)
    endif()
  endif()
  set(${output} "${available}" PARENT_SCOPE)
endfunction()

function(obs_native_test_graph path root)
  _obs_test_graph_x11_display(HAVE_X11_DISPLAY)
  set(HAVE_QT_CORE_TEST_OWNER FALSE)
  set(HAVE_CRASH_LOG_TEST_OWNER FALSE)
  if(TARGET Qt6::Core)
    set(HAVE_QT_CORE_TEST_OWNER TRUE)
    if(TARGET nlohmann_json::nlohmann_json)
      set(HAVE_CRASH_LOG_TEST_OWNER TRUE)
    endif()
  endif()
  # The original filename fixture adds its muxer branch only with the Linux
  # renderer owner. Keep its artifact definition on that same conditional edge.
  if(OS_LINUX AND TARGET OBS::libobs-opengl AND NOT TARGET OBS::output-filename-mux-test)
    add_library(OBS::output-filename-mux-test INTERFACE IMPORTED)
    set_property(
      TARGET OBS::output-filename-mux-test
      PROPERTY INTERFACE_COMPILE_DEFINITIONS TEST_FFMPEG_MUX GRAPHICS_MODULE_PATH="$<TARGET_FILE:OBS::libobs-opengl>"
    )
    add_dependencies(OBS::output-filename-mux-test OBS::libobs-opengl)
  endif()
  # Qt helpers are optional even when another component imported a Qt target.
  # An explicitly disabled UI/frontend must not enable their fixture owners.
  set(HAVE_QT_WIDGETS_TEST_OWNER FALSE)
  set(HAVE_QT_WIDGETS_TESTLIB_OWNER FALSE)
  if((NOT DEFINED ENABLE_UI OR ENABLE_UI) AND (NOT DEFINED ENABLE_FRONTEND OR ENABLE_FRONTEND) AND TARGET Qt6::Widgets)
    set(HAVE_QT_WIDGETS_TEST_OWNER TRUE)
    if(TARGET Qt6::Test)
      set(HAVE_QT_WIDGETS_TESTLIB_OWNER TRUE)
    endif()
  endif()
  set(HAVE_PLUGIN_MANAGER_TEST_OWNER FALSE)
  if(HAVE_QT_WIDGETS_TEST_OWNER AND TARGET Qt6::Svg AND TARGET OBS::idian AND TARGET nlohmann_json::nlohmann_json)
    set(HAVE_PLUGIN_MANAGER_TEST_OWNER TRUE)
  endif()
  set(HAVE_VST_EDITOR_TEST_OWNER FALSE)
  if(HAVE_QT_WIDGETS_TEST_OWNER AND TARGET test_vst_editor_close_module AND TARGET test_vst_editor_close_plugin)
    set(HAVE_VST_EDITOR_TEST_OWNER TRUE)
  endif()
  if(NOT DEFINED HAVE_PRIVATE_DAEMON_TEST_OWNER)
    set(HAVE_PRIVATE_DAEMON_TEST_OWNER FALSE)
    if(OS_LINUX)
      find_program(_graph_pipewire pipewire)
      find_program(_graph_wireplumber wireplumber)
      find_program(_graph_pipewire_pulse pipewire-pulse)
      find_program(_graph_pactl pactl)
      find_program(_graph_dbus_run_session dbus-run-session)
      if(_graph_pipewire AND _graph_wireplumber AND _graph_pipewire_pulse AND _graph_pactl AND _graph_dbus_run_session)
        set(HAVE_PRIVATE_DAEMON_TEST_OWNER TRUE)
      endif()
    endif()
  endif()
  # Camera fixtures create their own PipeWire daemon and fake D-Bus portal.
  # Missing tools/SDKs and other hosts disable them without probing hardware.
  if(NOT DEFINED HAVE_PIPEWIRE_CAMERA_TEST_OWNER)
    set(HAVE_PIPEWIRE_CAMERA_TEST_OWNER FALSE)
    if(OS_LINUX AND TARGET OBS::pipewire AND TARGET OBS::glad AND TARGET OBS::libobs-opengl)
      find_package(PipeWire 0.3.60 QUIET)
      find_package(X11 QUIET)
      find_package(PkgConfig QUIET)
      find_program(_camera_pipewire pipewire)
      find_program(_camera_dbus dbus-daemon)
      find_program(_camera_uv uv)
      if(PKG_CONFIG_FOUND)
        pkg_check_modules(_camera_test_sdk QUIET libdrm glib-2.0 gobject-2.0 gio-2.0)
        if(
          PipeWire_FOUND
          AND X11_FOUND
          AND _camera_test_sdk_FOUND
          AND _camera_pipewire
          AND _camera_dbus
          AND _camera_uv
          AND TARGET gio::gio
        )
          set(HAVE_PIPEWIRE_CAMERA_TEST_OWNER TRUE)
        endif()
      endif()
    endif()
  endif()
  if(NOT DEFINED HAVE_V4L2_VMIC_TEST_OWNER)
    set(HAVE_V4L2_VMIC_TEST_OWNER FALSE)
    if(OS_LINUX AND TARGET OBS::v4l2 AND HAVE_PRIVATE_DAEMON_TEST_OWNER)
      find_program(_vmic_record pw-record)
      if(_vmic_record)
        set(HAVE_V4L2_VMIC_TEST_OWNER TRUE)
      endif()
    endif()
  endif()
  set(HAVE_STARTUP_X11 FALSE)
  if(TARGET X11::X11)
    set(HAVE_STARTUP_X11 TRUE)
  endif()
  set(HAVE_HAPPY_EYEBALLS FALSE)
  if(TARGET OBS::happy-eyeballs)
    set(HAVE_HAPPY_EYEBALLS TRUE)
  endif()
  set(HAVE_LIBOBS_RUST_STATIC FALSE)
  if(TARGET libobs_rust-static)
    set(HAVE_LIBOBS_RUST_STATIC TRUE)
  endif()
  set(HAVE_LIBOBS FALSE)
  if(TARGET OBS::libobs)
    set(HAVE_LIBOBS TRUE)
  endif()
  # Private portal fixtures create their own bus; SDK absence is an exclusion.
  set(HAVE_PORTAL_TEST_GIO FALSE)
  if(OS_LINUX OR OS_FREEBSD)
    find_package(Gio QUIET)
    find_package(PkgConfig QUIET)
    if(PKG_CONFIG_FOUND)
      pkg_check_modules(PORTAL_TEST_GLIB QUIET IMPORTED_TARGET glib-2.0 gobject-2.0)
      pkg_check_modules(INHIBIT_TEST_GLIB QUIET IMPORTED_TARGET glib-2.0 gobject-2.0)
    endif()
    if(TARGET gio::gio AND TARGET PkgConfig::PORTAL_TEST_GLIB AND TARGET PkgConfig::INHIBIT_TEST_GLIB)
      set(HAVE_PORTAL_TEST_GIO TRUE)
    endif()
  endif()
  file(READ "${path}" graph)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
  _obs_test_graph_fields("${graph}" "" "schema;targets;tests")
  string(JSON schema GET "${graph}" schema)
  if(NOT schema EQUAL 1)
    message(FATAL_ERROR "Unsupported native test graph schema ${schema}")
  endif()
  set(selected_targets)
  set(graph_targets)
  set(ui_outputs)
  string(JSON count LENGTH "${graph}" targets)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON name MEMBER "${graph}" targets ${index})
      list(APPEND graph_targets "${name}")
      # Query one target through its own small document: every string(JSON) call
      # reparses its whole input, and the full graph made this loop quadratic.
      string(JSON target_graph_kind TYPE "${graph}" targets "${name}")
      if(NOT target_graph_kind STREQUAL "OBJECT")
        message(FATAL_ERROR "Native test graph targets;${name} must be an object")
      endif()
      string(JSON target_graph_entry GET "${graph}" targets "${name}")
      string(JSON target_graph SET "{}" targets "{}")
      string(JSON target_graph SET "${target_graph}" targets "${name}" "${target_graph_entry}")
      _obs_test_graph_fields(
        "${target_graph}"
        "targets;${name}"
        "sources;msvc_import_library;qt;cpp_standard;requires;includes;includes_before;definitions;artifact_definitions;watch_inputs;packages;header_packages;header_libraries;archives;libraries;compile_options;compile_options_if_supported;link_options;conditional_link_options;sanitizers"
      )
      string(JSON cpp_kind ERROR_VARIABLE cpp_error TYPE "${target_graph}" targets "${name}" cpp_standard)
      set(cpp_standard "")
      if(NOT cpp_error AND NOT cpp_kind STREQUAL "NULL")
        string(JSON cpp_standard GET "${target_graph}" targets "${name}" cpp_standard)
        if(NOT cpp_kind STREQUAL "STRING" OR NOT cpp_standard MATCHES "^(17|20)$")
          message(FATAL_ERROR "Invalid native test cpp_standard for ${name}: expected 17 or 20 as a string")
        endif()
      endif()
      _obs_test_graph_array(ui_forms "${target_graph}" targets "${name}" qt uic)
      foreach(form IN LISTS ui_forms)
        get_filename_component(ui_stem "${form}" NAME_WLE)
        string(TOLOWER "${ui_stem}" ui_key)
        if(ui_key IN_LIST ui_outputs)
          message(FATAL_ERROR "Duplicate Qt UI output ui_${ui_stem}.h")
        endif()
        list(APPEND ui_outputs "${ui_key}")
      endforeach()
      _obs_test_graph_requirement(selected "${target_graph}" targets "${name}" requires)
      if(NOT selected)
        continue()
      endif()
      _obs_test_graph_array(watch_inputs "${target_graph}" targets "${name}" watch_inputs)
      string(JSON watch_count ERROR_VARIABLE watch_error LENGTH "${target_graph}" targets "${name}" watch_inputs)
      if(NOT watch_error AND watch_count GREATER 0)
        math(EXPR watch_last "${watch_count} - 1")
        foreach(watch_index RANGE ${watch_last})
          string(JSON input GET "${target_graph}" targets "${name}" watch_inputs ${watch_index})
          string(FIND "${input}" "\\" backslash)
          if(
            input STREQUAL ""
            OR IS_ABSOLUTE "${input}"
            OR NOT backslash EQUAL -1
            OR input MATCHES "[:;\n\r\t]"
            OR input MATCHES "(^|/)\\.\\.?(/|$)|//|/$"
          )
            message(FATAL_ERROR "Invalid native test watch input ${input}")
          endif()
          set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${root}/${input}")
        endforeach()
      endif()
      _obs_test_graph_sources(sources "${target_graph}" "${name}")
      if(NOT sources)
        message(FATAL_ERROR "Native test target ${name} has no sources")
      endif()
      set(inputs)
      foreach(source IN LISTS sources)
        if(source MATCHES "\\.(c|m)\\.h$|\\.(cpp|mm)\\.hpp$")
          if(source MATCHES "\\.cpp\\.hpp$")
            set(extension cpp)
          elseif(source MATCHES "\\.mm\\.hpp$")
            set(extension mm)
          elseif(source MATCHES "\\.m\\.h$")
            set(extension m)
          else()
            set(extension c)
          endif()
          set(wrapper "${CMAKE_CURRENT_BINARY_DIR}/native-tests/${name}/${source}.${extension}")
          file(GENERATE OUTPUT "${wrapper}" CONTENT "#include \"${root}/${source}\"\n")
          list(APPEND inputs "${wrapper}")
        else()
          list(APPEND inputs "${root}/${source}")
        endif()
      endforeach()
      add_executable(${name} ${inputs})
      string(JSON import_kind ERROR_VARIABLE import_error TYPE "${target_graph}" targets "${name}" msvc_import_library)
      if(NOT import_error AND NOT import_kind STREQUAL "NULL")
        _obs_test_graph_fields("${target_graph}" "targets;${name};msvc_import_library" "definition;output")
        string(JSON import_definition GET "${target_graph}" targets "${name}" msvc_import_library definition)
        string(JSON import_output GET "${target_graph}" targets "${name}" msvc_import_library output)
        if(
          import_definition MATCHES "(^/|\\\\|:|;|(^|/)\\.\\.?(/|$))"
          OR NOT import_definition MATCHES "\\.def$"
          OR NOT import_output MATCHES "^[A-Za-z0-9_-]+\\.lib$"
        )
          message(FATAL_ERROR "Invalid native test MSVC import library for ${name}")
        endif()
        if(MSVC)
          set(import_library "${CMAKE_CURRENT_BINARY_DIR}/${import_output}")
          add_custom_command(
            OUTPUT "${import_library}"
            COMMAND
              "${CMAKE_AR}" /nologo "/def:${root}/${import_definition}" "/machine:${CMAKE_C_COMPILER_ARCHITECTURE_ID}"
              "/out:${import_library}"
            DEPENDS "${root}/${import_definition}"
            VERBATIM
          )
          target_sources(${name} PRIVATE "${import_library}")
          # DATA-only address slot resolves before the ordinary libobs import library.
          target_link_libraries(${name} PRIVATE "${import_library}")
        endif()
      endif()

      string(JSON qt_kind ERROR_VARIABLE qt_error TYPE "${target_graph}" targets "${name}" qt)
      if(NOT qt_error)
        _obs_test_graph_fields("${target_graph}" "targets;${name};qt" "moc;uic;rcc")
        _obs_test_graph_array(moc_headers "${target_graph}" targets "${name}" qt moc)
        foreach(header IN LISTS moc_headers)
          target_sources(${name} PRIVATE "${root}/${header}")
        endforeach()
        if(moc_headers)
          set_target_properties(${name} PROPERTIES AUTOMOC ON)
        endif()
        _obs_test_graph_array(ui_forms "${target_graph}" targets "${name}" qt uic)
        set(ui_inputs)
        foreach(form IN LISTS ui_forms)
          list(APPEND ui_inputs "${root}/${form}")
        endforeach()
        if(ui_inputs)
          qt6_wrap_ui(ui_headers ${ui_inputs})
          target_sources(${name} PRIVATE ${ui_headers})
          target_include_directories(${name} BEFORE PRIVATE "${CMAKE_CURRENT_BINARY_DIR}")
        endif()
        _obs_test_graph_array(resource_collections "${target_graph}" targets "${name}" qt rcc)
        set(resource_inputs)
        foreach(collection IN LISTS resource_collections)
          list(APPEND resource_inputs "${root}/${collection}")
        endforeach()
        if(resource_inputs)
          qt6_add_resources(resource_sources ${resource_inputs})
          target_sources(${name} PRIVATE ${resource_sources})
        endif()
      endif()
      if(NOT cpp_standard STREQUAL "")
        set_target_properties(
          ${name}
          PROPERTIES CXX_STANDARD ${cpp_standard} CXX_STANDARD_REQUIRED TRUE CXX_EXTENSIONS FALSE
        )
      endif()
      _obs_test_graph_array(includes_before "${target_graph}" targets "${name}" includes_before)
      set(priority_includes)
      foreach(directory IN LISTS includes_before)
        list(APPEND priority_includes "${root}/${directory}")
      endforeach()
      if(priority_includes)
        target_include_directories(${name} BEFORE PRIVATE ${priority_includes})
      endif()
      target_include_directories(${name} PRIVATE "${root}")
      list(APPEND selected_targets "${name}")
      if(TARGET cmocka-tests)
        add_dependencies(cmocka-tests ${name})
      endif()
      _obs_test_graph_array(includes "${target_graph}" targets "${name}" includes)
      foreach(directory IN LISTS includes)
        target_include_directories(${name} PRIVATE "${root}/${directory}")
      endforeach()
      _obs_test_graph_array(header_libraries "${target_graph}" targets "${name}" header_libraries)
      foreach(library IN LISTS header_libraries)
        if(NOT TARGET "${library}")
          message(FATAL_ERROR "Unresolved native test header library ${library}")
        endif()
        get_target_property(header_directories "${library}" INTERFACE_INCLUDE_DIRECTORIES)
        if(header_directories)
          target_include_directories(${name} PRIVATE ${header_directories})
        endif()
      endforeach()
      string(
        JSON artifact_kind
        ERROR_VARIABLE artifact_error
        TYPE "${target_graph}"
        targets
        "${name}"
        artifact_definitions
      )
      if(NOT artifact_error)
        if(NOT artifact_kind STREQUAL "OBJECT")
          message(FATAL_ERROR "Native test artifact definitions must be an object")
        endif()
        string(JSON artifact_count LENGTH "${target_graph}" targets "${name}" artifact_definitions)
        if(artifact_count GREATER 0)
          math(EXPR artifact_last "${artifact_count} - 1")
          foreach(artifact_index RANGE ${artifact_last})
            string(JSON definition MEMBER "${target_graph}" targets "${name}" artifact_definitions ${artifact_index})
            string(JSON artifact_type TYPE "${target_graph}" targets "${name}" artifact_definitions "${definition}")
            string(JSON artifact GET "${target_graph}" targets "${name}" artifact_definitions "${definition}")
            if(
              NOT definition MATCHES "^[A-Za-z_][A-Za-z0-9_]*$"
              OR NOT artifact_type STREQUAL "STRING"
              OR artifact STREQUAL ""
            )
              message(FATAL_ERROR "Invalid native test artifact definition ${definition}")
            endif()
            if(NOT TARGET "${artifact}")
              message(FATAL_ERROR "Unresolved native test artifact ${artifact}")
            endif()
            get_target_property(artifact_target_type "${artifact}" TYPE)
            if(
              NOT
                artifact_target_type
                  MATCHES
                  "^(STATIC_LIBRARY|SHARED_LIBRARY|MODULE_LIBRARY|EXECUTABLE|UNKNOWN_LIBRARY)$"
            )
              message(FATAL_ERROR "Native test artifact ${artifact} requires exactly one file artifact")
            endif()
            target_compile_definitions(${name} PRIVATE "${definition}=\"$<TARGET_FILE:${artifact}>\"")
            get_target_property(artifact_alias "${artifact}" ALIASED_TARGET)
            if(artifact_alias)
              add_dependencies(${name} "${artifact_alias}")
            else()
              add_dependencies(${name} "${artifact}")
            endif()
          endforeach()
        endif()
      endif()
      foreach(field IN ITEMS definitions link_options)
        _obs_test_graph_array(values "${target_graph}" targets "${name}" ${field})
        if(NOT values)
          continue()
        endif()
        if(field STREQUAL "definitions")
          foreach(value IN LISTS values)
            if(value MATCHES "\\$\\{(target|runtime)\\}")
              message(
                FATAL_ERROR
                "Native test compile definition cannot reference its target executable or runtime directory"
              )
            endif()
            _obs_test_graph_expand(value "${value}" "${root}" "${name}")
            target_compile_definitions(${name} PRIVATE "${value}")
          endforeach()
        elseif(field STREQUAL "link_options")
          target_link_options(${name} PRIVATE ${values})
        endif()
      endforeach()
      _obs_test_graph_values(link_flags "${target_graph}" "${name}" conditional_link_options)
      if(link_flags)
        target_link_options(${name} PRIVATE ${link_flags})
      endif()
      _obs_test_graph_values(flags "${target_graph}" "${name}" compile_options)
      if(flags)
        target_compile_options(${name} PRIVATE ${flags})
      endif()
      _obs_test_graph_values(libraries "${target_graph}" "${name}" libraries)
      if(libraries)
        target_link_libraries(${name} PRIVATE ${libraries})
      endif()
      foreach(field IN ITEMS packages header_packages)
        _obs_test_graph_array(packages "${target_graph}" targets "${name}" ${field})
        foreach(package IN LISTS packages)
          find_package(PkgConfig REQUIRED)
          string(MAKE_C_IDENTIFIER "native_test_${name}_${package}" prefix)
          pkg_check_modules(${prefix} REQUIRED IMPORTED_TARGET "${package}")
          if(field STREQUAL "packages")
            target_link_libraries(${name} PRIVATE PkgConfig::${prefix})
          else()
            target_include_directories(${name} SYSTEM PRIVATE ${${prefix}_INCLUDE_DIRS})
            # Header-only dependencies expose declarations and preprocessor
            # definitions without importing a library's build/link policy.
            # Match obs-build's headers_only(), rather than PkgConfig's full
            # imported target. Required extra flags belong in compile_options.
            foreach(flag IN LISTS ${prefix}_CFLAGS_OTHER)
              if(flag MATCHES "^-D(.+)$")
                target_compile_definitions(${name} PRIVATE "${CMAKE_MATCH_1}")
              endif()
            endforeach()
          endif()
        endforeach()
      endforeach()
      _obs_test_graph_array(archives "${target_graph}" targets "${name}" archives)
      foreach(archive IN LISTS archives)
        target_link_libraries(${name} PRIVATE OBS::${archive})
      endforeach()
      string(JSON sanitizer ERROR_VARIABLE error GET "${target_graph}" targets "${name}" sanitizers)
      if(NOT error)
        obs_test_sanitize(${name} "${sanitizer}")
      endif()
      _obs_test_graph_array(flags "${target_graph}" targets "${name}" compile_options_if_supported)
      if(flags)
        include(CheckCCompilerFlag)
        foreach(flag IN LISTS flags)
          string(MAKE_C_IDENTIFIER "native_test_flag_${flag}" variable)
          check_c_compiler_flag("${flag}" ${variable})
          if(${variable})
            target_compile_options(${name} PRIVATE "${flag}")
          endif()
        endforeach()
      endif()
    endforeach()
  endif()
  string(JSON count LENGTH "${graph}" tests)
  if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
      string(JSON name MEMBER "${graph}" tests ${index})
      # Query one test through its own small document: every string(JSON) call
      # reparses its whole input, and the full graph made this loop quadratic.
      string(JSON test_graph_kind TYPE "${graph}" tests "${name}")
      if(NOT test_graph_kind STREQUAL "OBJECT")
        message(FATAL_ERROR "Native test graph tests;${name} must be an object")
      endif()
      string(JSON test_graph_entry GET "${graph}" tests "${name}")
      string(JSON test_graph SET "{}" tests "{}")
      string(JSON test_graph SET "${test_graph}" tests "${name}" "${test_graph_entry}")
      _obs_test_graph_fields(
        "${test_graph}"
        "tests;${name}"
        "target;suite;requires;command;optional_prefixes;optional_prefixes_requires;timeout_seconds;skip_return_code;environment;environment_path_prepend;qt_runtime;working_directory;resource_locks;run_serial"
      )
      string(JSON suite ERROR_VARIABLE suite_error GET "${test_graph}" tests "${name}" suite)
      if(suite_error)
        set(suite core)
      else()
        string(JSON suite_kind TYPE "${test_graph}" tests "${name}" suite)
        if(NOT suite_kind STREQUAL "STRING" OR NOT suite MATCHES "^[A-Za-z0-9_.-]+$")
          message(FATAL_ERROR "Invalid native test suite ${suite}")
        endif()
      endif()
      string(JSON target GET "${test_graph}" tests "${name}" target)
      if(NOT target IN_LIST graph_targets)
        message(FATAL_ERROR "Native test ${name} references absent target ${target}")
      endif()
      _obs_test_graph_requirement(selected "${test_graph}" tests "${name}" requires)
      if(NOT selected OR NOT target IN_LIST selected_targets)
        continue()
      endif()
      string(JSON command_kind ERROR_VARIABLE error TYPE "${test_graph}" tests "${name}" command)
      if(error)
        set(command "\${target}")
      else()
        _obs_test_graph_array(command "${test_graph}" tests "${name}" command)
      endif()
      if(NOT command)
        message(FATAL_ERROR "Native test ${name} has no command")
      endif()
      set(arguments)
      foreach(argument IN LISTS command)
        _obs_test_graph_expand(argument "${argument}" "${root}" "${target}")
        string(REPLACE ";" "\\;" argument "${argument}")
        list(APPEND arguments "${argument}")
      endforeach()
      string(JSON prefixes_kind ERROR_VARIABLE prefixes_error TYPE "${test_graph}" tests "${name}" optional_prefixes)
      _obs_test_graph_requirement(prefixes_selected "${test_graph}" tests "${name}" optional_prefixes_requires)
      if(NOT prefixes_error)
        if(NOT prefixes_kind STREQUAL "ARRAY")
          message(FATAL_ERROR "Native test command prefixes must be an array")
        endif()
        string(JSON prefixes_count LENGTH "${test_graph}" tests "${name}" optional_prefixes)
        if(prefixes_count GREATER 0)
          math(EXPR prefix_last "${prefixes_count} - 1")
          foreach(prefix_index RANGE ${prefix_last} 0 -1)
            _obs_test_graph_array(prefix "${test_graph}" tests "${name}" optional_prefixes ${prefix_index})
            string(JSON prefix_count LENGTH "${test_graph}" tests "${name}" optional_prefixes ${prefix_index})
            if(prefix_count EQUAL 0)
              message(FATAL_ERROR "Native test command prefix needs a literal program")
            endif()
            string(
              JSON prefix_program
              GET "${test_graph}"
              tests
              "${name}"
              optional_prefixes
              ${prefix_index}
              0
            )
            if(prefix_program STREQUAL "" OR prefix_program MATCHES "\\$\\{")
              message(FATAL_ERROR "Native test command prefix needs a literal program")
            endif()
            # Validate syntax even when this optional program is unavailable.
            # Expansion below still uses the real target/runtime context.
            foreach(argument IN LISTS prefix)
              string(REGEX REPLACE "\\$\\{(source|build|runtime|target)\\}" "" remaining "${argument}")
              if(remaining MATCHES "\\$\\{")
                message(FATAL_ERROR "Unknown native test template ${argument}")
              endif()
            endforeach()
            unset(prefix_executable)
            string(MAKE_C_IDENTIFIER "${prefix_program}" prefix_variable)
            string(TOUPPER "${prefix_variable}" prefix_variable)
            if(DEFINED ${prefix_variable} AND ${prefix_variable})
              set(prefix_executable "${${prefix_variable}}")
            else()
              find_program(prefix_executable NAMES "${prefix_program}" NO_CACHE)
            endif()
            if(prefix_executable AND prefixes_selected)
              set(expanded_prefix "${prefix_executable}")
              list(REMOVE_AT prefix 0)
              foreach(argument IN LISTS prefix)
                _obs_test_graph_expand(argument "${argument}" "${root}" "${target}")
                string(REPLACE ";" "\\;" argument "${argument}")
                list(APPEND expanded_prefix "${argument}")
              endforeach()
              list(PREPEND arguments ${expanded_prefix})
            endif()
          endforeach()
        endif()
      endif()
      add_test(NAME "${name}" COMMAND ${arguments})
      string(JSON qt_runtime ERROR_VARIABLE qt_runtime_error GET "${test_graph}" tests "${name}" qt_runtime)
      if(NOT qt_runtime_error)
        if(NOT TARGET "${qt_runtime}")
          message(FATAL_ERROR "Unresolved native test Qt runtime ${qt_runtime}")
        endif()
        cmocka_qt_runtime("${name}" "${qt_runtime}")
      endif()
      foreach(
        pair
        IN
        ITEMS
          "timeout_seconds;TIMEOUT"
          "skip_return_code;SKIP_RETURN_CODE"
          "working_directory;WORKING_DIRECTORY"
          "run_serial;RUN_SERIAL"
      )
        list(GET pair 0 field)
        list(GET pair 1 property)
        string(JSON value ERROR_VARIABLE error GET "${test_graph}" tests "${name}" ${field})
        if(NOT error)
          _obs_test_graph_expand(value "${value}" "${root}" "${target}")
          set_tests_properties("${name}" PROPERTIES ${property} "${value}")
        endif()
      endforeach()
      set_tests_properties("${name}" PROPERTIES LABELS "native-${suite}")
      _obs_test_graph_array(locks "${test_graph}" tests "${name}" resource_locks)
      if(locks)
        set_tests_properties("${name}" PROPERTIES RESOURCE_LOCK "${locks}")
      endif()
      string(JSON count_environment ERROR_VARIABLE error LENGTH "${test_graph}" tests "${name}" environment)
      if(NOT error AND count_environment GREATER 0)
        math(EXPR last_environment "${count_environment} - 1")
        foreach(environment_index RANGE ${last_environment})
          string(JSON key MEMBER "${test_graph}" tests "${name}" environment ${environment_index})
          string(JSON value GET "${test_graph}" tests "${name}" environment "${key}")
          _obs_test_graph_expand(value "${value}" "${root}" "${target}")
          string(REPLACE ";" "\\;" assignment "${key}=${value}")
          set_property(TEST "${name}" APPEND PROPERTY ENVIRONMENT "${assignment}")
        endforeach()
      endif()
      string(JSON path_kind ERROR_VARIABLE path_error TYPE "${test_graph}" tests "${name}" environment_path_prepend)
      if(NOT path_error)
        if(NOT path_kind STREQUAL "OBJECT")
          message(FATAL_ERROR "Native test environment_path_prepend must be an object")
        endif()
        string(JSON path_count LENGTH "${test_graph}" tests "${name}" environment_path_prepend)
        if(path_count GREATER 0)
          math(EXPR path_last "${path_count} - 1")
          foreach(path_index RANGE ${path_last})
            string(JSON key MEMBER "${test_graph}" tests "${name}" environment_path_prepend ${path_index})
            _obs_test_graph_array(paths "${test_graph}" tests "${name}" environment_path_prepend "${key}")
            list(REVERSE paths)
            foreach(value IN LISTS paths)
              _obs_test_graph_expand(value "${value}" "${root}" "${target}")
              string(REPLACE ";" "\\;" modification "${key}=path_list_prepend:${value}")
              set_property(TEST "${name}" APPEND PROPERTY ENVIRONMENT_MODIFICATION "${modification}")
            endforeach()
          endforeach()
        endif()
      endif()
    endforeach()
  endif()
endfunction()
