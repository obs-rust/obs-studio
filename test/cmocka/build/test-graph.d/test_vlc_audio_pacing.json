{
  "schema": 1,
  "targets": {
    "test_vlc_audio_pacing": {
      "sources": [
        "test/cmocka/test_vlc_audio_pacing.c"
      ],
      "libraries": [
        "OBS::libobs",
        "FFmpeg::avcodec",
        "FFmpeg::avformat",
        "FFmpeg::avutil",
        "OBS::native-test-cmocka",
        {
          "name": "m",
          "requires": {
            "not": "OS_WINDOWS"
          }
        }
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_VLC_MODULE",
          "HAVE_OBS_OPENGL"
        ]
      },
      "artifact_definitions": {
        "VLC_MODULE_PATH": "vlc-video",
        "GRAPHICS_MODULE_PATH": "OBS::libobs-opengl"
      },
      "definitions": [
        "VLC_DATA_PATH=\"${source}/plugins/vlc-video/data\""
      ],
      "watch_inputs": [
        "test/cmocka",
        "plugins/vlc-video",
        "libobs/data"
      ]
    }
  },
  "tests": {
    "test_vlc_audio_pacing": {
      "target": "test_vlc_audio_pacing",
      "command": [
        "${target}"
      ],
      "suite": "vlc",
      "working_directory": "${runtime}",
      "timeout_seconds": 120,
      "skip_return_code": 77
    }
  }
}
