{
  "schema": 1,
  "targets": {
    "test_video_frame_copy": {
      "sources": [
        "test/cmocka/test_video_frame_copy.c"
      ],
      "libraries": [
        "OBS::libobs",
        "OBS::native-test-cmocka"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_OBS_OPENGL"
        ]
      },
      "artifact_definitions": {
        "GRAPHICS_MODULE_PATH": "OBS::libobs-opengl"
      },
      "watch_inputs": [
        "libobs/data"
      ]
    }
  },
  "tests": {
    "test_video_frame_copy": {
      "target": "test_video_frame_copy",
      "command": [
        "${target}"
      ],
      "suite": "graphics",
      "working_directory": "${runtime}",
      "timeout_seconds": 180,
      "optional_prefixes": [
        [
          "xvfb-run",
          "-a"
        ]
      ]
    }
  }
}
