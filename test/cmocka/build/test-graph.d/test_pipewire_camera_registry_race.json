          "plugins/linux-pipewire/frame-layout.c.h",
          "plugins/linux-pipewire/frame-pacing.c.h",
          "plugins/linux-pipewire/portal.c.h",
          "plugins/linux-pipewire/reconnect-policy.c.h"
