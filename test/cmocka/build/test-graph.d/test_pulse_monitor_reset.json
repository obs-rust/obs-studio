{
  "schema": 1,
  "targets": {
    "test_pulse_monitor_reset": {
      "sources": [
        "test/cmocka/test_pulse_monitor_reset.c"
      ],
      "libraries": [
        "OBS::libobs",
        "OBS::native-test-cmocka",
        "PulseAudio::PulseAudio"
      ],
      "link_options": [
        "-Wl,--export-dynamic"
      ],
      "watch_inputs": [
        "libobs/data"
      ],
      "compile_options_if_supported": [
        "-fvisibility=default"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "ENABLE_PULSEAUDIO",
          "HAVE_X11_DISPLAY"
        ]
      }
    }
  },
  "tests": {
    "test_pulse_monitor_reset": {
      "target": "test_pulse_monitor_reset",
      "timeout_seconds": 30,
      "command": [
        "${target}",
        "failed_reset_preserves_monitor_lifetime"
      ],
      "suite": "graphics",
      "requires": {
        "all": [
          "OS_LINUX",
          "ENABLE_PULSEAUDIO",
          "HAVE_X11_DISPLAY"
        ]
      },
      "skip_return_code": 77,
      "optional_prefixes": [
        [
          "xvfb-run",
          "-a",
          "-s",
          "-screen 0 1280x1024x24 -noreset"
        ]
      ]
    },
    "test_pulse_monitor_reset_failed_context_replacement_failure_is_safe": {
      "target": "test_pulse_monitor_reset",
      "timeout_seconds": 30,
      "command": [
        "${target}",
