{
  "schema": 1,
  "targets": {
    "test_gl_dynamic_texture": {
      "sources": [
        "test/cmocka/test_gl_dynamic_texture.c"
      ],
      "libraries": [
        "OBS::libobs",
        "OBS::native-test-cmocka"
      ],
      "artifact_definitions": {
        "GRAPHICS_MODULE_PATH": "OBS::libobs-opengl"
      },
      "watch_inputs": [
        "libobs/data"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_OBS_OPENGL",
          "HAVE_X11_DISPLAY"
        ]
      }
    }
  },
  "tests": {
    "test_gl_dynamic_texture": {
      "target": "test_gl_dynamic_texture",
      "suite": "graphics",
      "command": [
        "${target}"
      ],
      "working_directory": "${runtime}",
      "timeout_seconds": 120
    }
  }
}
