{
  "schema": 1,
  "targets": {
    "obs_runtime_bench": {
      "sources": [
        "test/cmocka/obs_runtime_bench.c"
      ],
      "libraries": [
        "OBS::libobs",
        "OBS::native-test-cmocka",
        "m"
      ],
      "artifact_definitions": {
        "GRAPHICS_MODULE_PATH": "OBS::libobs-opengl"
      },
      "watch_inputs": [
        "libobs/data"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_X11_DISPLAY",
          "HAVE_OBS_OPENGL"
        ]
      }
    }
  },
  "tests": {
    "obs_runtime_bench_smoke": {
      "target": "obs_runtime_bench",
      "command": [
        "${target}",
        "--seconds",
        "1",
        "--warmup",
        "0.5"
      ],
      "working_directory": "${runtime}",
      "timeout_seconds": 60,
      "skip_return_code": 77,
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_X11_DISPLAY",
          "HAVE_OBS_OPENGL"
        ]
      },
      "suite": "graphics"
    }
  }
}
