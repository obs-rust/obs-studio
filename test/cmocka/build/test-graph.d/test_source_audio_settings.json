{
  "schema": 1,
  "targets": {
    "test_source_audio_settings": {
      "sources": [
        "test/cmocka/test_source_audio_settings.c"
      ],
      "libraries": [
        "OBS::libobs",
        {
          "name": "m",
          "requires": {
            "not": "MSVC"
          }
        },
        "OBS::native-test-cmocka"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_OBS_OPENGL"
        ]
      },
      "artifact_definitions": {
        "GRAPHICS_MODULE_PATH": "OBS::libobs-opengl"
      },
      "watch_inputs": [
        "libobs/data"
      ]
    }
  },
  "tests": {
    "test_source_audio_settings": {
      "target": "test_source_audio_settings",
      "command": [
        "${target}"
      ],
      "suite": "graphics",
      "working_directory": "${runtime}",
      "timeout_seconds": 120,
      "optional_prefixes": [
        [
          "xvfb-run",
          "-a",
          "-s",
          "-screen 0 1280x1024x24 -noreset"
        ]
      ]
    }
  }
}
