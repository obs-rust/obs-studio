{
  "schema": 1,
  "targets": {
    "test_image_size_precheck": {
      "sources": [
        "test/cmocka/test_image_size_precheck.c"
      ],
      "libraries": [
        "OBS::libobs",
        "OBS::native-test-cmocka",
        "ZLIB::ZLIB"
      ],
      "artifact_definitions": {
        "GRAPHICS_MODULE_PATH": "OBS::libobs-opengl"
      },
      "watch_inputs": [
        "libobs/data"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_OBS_OPENGL",
          "HAVE_X11_DISPLAY"
        ]
      }
    }
  },
  "tests": {
    "test_image_size_precheck": {
      "target": "test_image_size_precheck",
      "command": [
        "${target}"
      ],
      "timeout_seconds": 120,
      "working_directory": "${runtime}",
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_OBS_OPENGL",
          "HAVE_X11_DISPLAY"
        ]
      },
      "suite": "graphics"
    }
  }
}
