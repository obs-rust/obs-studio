{
  "schema": 1,
  "targets": {
    "test_output_input_checks": {
      "sources": [
        "test/cmocka/test_output_input_checks.c"
      ],
      "libraries": [
        "OBS::libobs",
        "OBS::native-test-cmocka"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_OBS_OPENGL"
        ]
      },
      "artifact_definitions": {
        "GRAPHICS_MODULE_PATH": "OBS::libobs-opengl"
      },
      "watch_inputs": [
        "libobs/data"
      ],
      "sanitizers": "address,undefined"
    }
  },
  "tests": {
    "test_output_input_checks": {
      "target": "test_output_input_checks",
      "command": [
        "${target}"
      ],
      "suite": "graphics",
      "working_directory": "${runtime}",
      "timeout_seconds": 60,
      "skip_return_code": 77,
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=0"
      }
    }
  }
}
