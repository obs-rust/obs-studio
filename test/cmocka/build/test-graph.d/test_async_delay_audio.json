{
  "schema": 1,
  "targets": {
    "test_async_delay_audio": {
      "sources": [
        "test/cmocka/test_async_delay_audio.c",
        "plugins/obs-filters/async-delay-filter.c.h"
      ],
      "libraries": [
        "OBS::libobs",
        "OBS::native-test-cmocka",
        "m"
      ],
      "artifact_definitions": {
        "GRAPHICS_MODULE_PATH": "OBS::libobs-opengl"
      },
      "watch_inputs": [
        "libobs/data"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_OBS_OPENGL",
          "HAVE_X11_DISPLAY"
        ]
      }
    }
  },
  "tests": {
    "test_async_delay_audio": {
      "target": "test_async_delay_audio",
      "command": [
        "${target}"
      ],
      "working_directory": "${runtime}",
      "resource_locks": [
        "timing"
      ],
      "timeout_seconds": 180,
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_OBS_OPENGL",
          "HAVE_X11_DISPLAY"
        ]
      },
      "suite": "graphics"
    }
  }
}
