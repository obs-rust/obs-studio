{
  "schema": 1,
  "targets": {
    "test_media_cached_paused_seek": {
      "sources": [
        "test/cmocka/test_media_cached_paused_seek.c"
      ],
      "libraries": [
        "OBS::libobs",
        "OBS::media-playback",
        "FFmpeg::swscale",
        "FFmpeg::swresample",
        "OBS::native-test-cmocka",
        {
          "name": "m",
          "requires": {
            "any": [
              "OS_LINUX",
              "OS_FREEBSD",
              "OS_OPENBSD"
            ]
          }
        }
      ],
      "requires": {
        "all": [
          "HAVE_MEDIA_PLAYBACK_TEST_OWNER"
        ]
      },
      "watch_inputs": [
        "shared/media-playback/build/media-playback-cache.pch.h",
        "shared/media-playback/build/media-playback.cache+.h.c",
        "shared/media-playback/build/media-playback.core+.h.c",
        "shared/media-playback/build/media-playback.pch.h",
        "shared/media-playback/media-playback/cache.c.h",
        "shared/media-playback/media-playback/cache.h",
        "shared/media-playback/media-playback/closest-format.h",
        "shared/media-playback/media-playback/decode.c.h",
        "shared/media-playback/media-playback/decode.h",
        "shared/media-playback/media-playback/media-playback.c.h",
        "shared/media-playback/media-playback/media-playback.h",
        "shared/media-playback/media-playback/media.c.h",
        "shared/media-playback/media-playback/media.h",
        "shared/media-playback/media-playback/network-timeout.c.h",
        "shared/media-playback/media-playback/network-timeout.h",
        "shared/media-playback/media-playback/platform-decode-ffmpeg.h",
        "shared/media-playback/media-playback/platform-media-ffmpeg.h",
        "test/cmocka/data/media_cached_paused_seek.mkv"
      ]
    }
  },
  "tests": {
    "test_media_cached_paused_seek": {
      "target": "test_media_cached_paused_seek",
      "timeout_seconds": 20,
      "command": [
        "${target}",
        "${source}/test/cmocka/data/media_cached_paused_seek.mkv"
      ],
      "working_directory": "${build}"
    }
  }
}
