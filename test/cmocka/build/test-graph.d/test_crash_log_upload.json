{
  "schema": 1,
  "targets": {
    "test_crash_log_upload": {
      "sources": [
        "test/cmocka/test_crash_log_upload.cpp",
        "frontend/utility/CrashHandler.cpp.hpp",
        "frontend/utility/CrashHandler_Linux.cpp.hpp"
      ],
      "cpp_standard": "17",
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_CRASH_LOG_TEST_OWNER"
        ]
      },
      "includes": [
        "frontend/utility",
        "frontend"
      ],
      "libraries": [
        "OBS::libobs",
        "Qt6::Core",
        "nlohmann_json::nlohmann_json",
        "OBS::native-test-cmocka"
      ],
      "qt": {
        "moc": [
          "frontend/utility/CrashHandler.hpp",
          "frontend/utility/RemoteTextThread.hpp"
        ]
      },
      "includes_before": [
        "test/cmocka/crash-handler-stubs"
      ],
      "watch_inputs": [
        "test/cmocka/crash-handler-stubs"
      ]
    }
  },
  "tests": {
    "test_crash_log_upload": {
      "target": "test_crash_log_upload",
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_CRASH_LOG_TEST_OWNER"
        ]
      },
      "command": [
        "${target}"
      ],
      "qt_runtime": "Qt6::Core",
      "timeout_seconds": 60
    }
  }
}
