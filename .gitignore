# Ignore generated and local files only. New source anywhere is picked up
# without editing this file (ci/test_gitignore.py checks that).

# CMake build trees and user presets
/build/
/build_*/
/out/
/release/
CMakeUserPresets.json
# Prebuilt dependencies the Windows/macOS builds and the cross-compile check
# (cmake/cross/) download from CMakePresets.json
/.deps/
/cmake/.CMakeBuildNumber
compile_commands.json

# Cargo build output
/target/
# The Dylint pass of the local gate (ci/local_gate.py soldr_dylint, #2293).
/target-dylint/
# zackees/setup-soldr's cook-cache side files, restored beside target/.
/target.soldr-*
/dylints/*/target/

# Python
__pycache__/
*.py[cod]

# Exclude lock files
*.lock.json
# The AppImage build pins its prebuilt dependencies here (obs-rust/obs-studio-libs, #926).
!/build-aux/appimage/manylinux/deps.lock.json

# Exclude files generated by Sphinx in-tree
/docs/sphinx/_build/*
!/docs/sphinx/_build/.gitignore
!/docs/sphinx/Makefile

# Exclude modified Flatpak files
build-aux/flatpak-github-action-modified-*

# Editors and OS
.DS_Store
.vs/
.idea/
*.swp
*~

# Local agent state; the shared project settings are tracked (#691)
/.claude/*
!/.claude/settings.json
!/.claude/skills/
/.clud/*
!/.clud/settings.json

# Offline Flatpak Rust dependencies prepared before entering the sandbox.
/.flatpak-rust/

# AppImage build intermediates written into the checkout (build-aux/appimage/README.md)
/AppDir/
/appimagetool
/squashfs-root/
/.apt-cache/

# CI and measurement evidence dumps: run metadata never lands in the tree.
# The attestations that matter are commit-message trailers (Local-Gate /
# Ci-Attestation); run output belongs in Actions artifacts or a side branch.
# (docs/ci-evidence/ is retired separately: its files are tracked today, and
# ci/test_gitignore.py rightly forbids ignoring tracked files.)
/ci-evidence-*/
/ci-evidence/
