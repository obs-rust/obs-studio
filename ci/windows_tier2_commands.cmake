macro(subdirs)
  foreach(child ${ARGV})
    if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/${child}/CTestTestfile.cmake")
      include("${CMAKE_CURRENT_LIST_DIR}/${child}/CTestTestfile.cmake")
    endif()
  endforeach()
endmacro()
