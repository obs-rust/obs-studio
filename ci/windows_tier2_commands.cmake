# Read generated CTest argument vectors without CTest's host executable lookup.
# Properties still come from CTest JSON; this only recovers omitted commands.
function(add_test name)
  set(record "[]")
  math(EXPR last "${ARGC} - 1")
  foreach(index RANGE 1 ${last})
    set(value "${ARGV${index}}")
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    math(EXPR item "${index} - 1")
    string(JSON record SET "${record}" ${item} "\"${value}\"")
  endforeach()
  string(JSON records SET "${records}" "${name}" "${record}")
  set(records "${records}" PARENT_SCOPE)
endfunction()
