# Canonical tests use MSVC ABI policy even with soldr's GNU-style clang driver.
# Adapt only the driver's spelling; native MSVC/clang-cl options are untouched.
function(obs_windows_tier2_driver_options directory)
  if(NOT CMAKE_C_COMPILER_FRONTEND_VARIANT STREQUAL "GNU" OR NOT CMAKE_C_SIMULATE_ID STREQUAL "MSVC")
    return()
  endif()
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    foreach(_property IN ITEMS COMPILE_OPTIONS INTERFACE_COMPILE_OPTIONS)
      get_target_property(_options "${_target}" "${_property}")
      if(_options)
        string(REPLACE "/O1" "-Os" _options "${_options}")
        string(REPLACE "/fp:strict" "-ffp-model=strict" _options "${_options}")
        string(REPLACE "/std:c11" "-std=c11" _options "${_options}")
        # C11 atomics are already implemented by clang in C11 mode.
        string(REPLACE "/experimental:c11atomics" "" _options "${_options}")
        string(REGEX REPLACE "(^|;|>:)/D" "\\1-D" _options "${_options}")
        string(REPLACE "/clang:" "" _options "${_options}")
        set_property(TARGET "${_target}" PROPERTY "${_property}" "${_options}")
      endif()
    endforeach()
    foreach(_property IN ITEMS LINK_OPTIONS INTERFACE_LINK_OPTIONS)
      get_target_property(_options "${_target}" "${_property}")
      if(_options)
        string(REGEX REPLACE "(^|;|>:)(/[^;<>]+)" "\\1LINKER:\\2" _options "${_options}")
        set_property(TARGET "${_target}" PROPERTY "${_property}" "${_options}")
      endif()
    endforeach()
  endforeach()
  get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _children)
    obs_windows_tier2_driver_options("${_child}")
  endforeach()
endfunction()

# The native speed pass excludes test/ and deps/ relative to the OBS root.
# This opt-in project's source directory is cmake/cross; retain those exact
# exclusions rather than batching unchanged characterization tests together.
function(_obs_windows_tier2_native_build_speed directory)
  _obs_groups_all("${directory}")
  set(CMAKE_SOURCE_DIR "${OBS_SOURCE_ROOT}")
  _obs_build_speed_all("${directory}")
endfunction()
function(obs_windows_tier2_native_layout)
cmake_language(DEFER GET_CALL_IDS _tier2_deferred)
foreach(_call IN LISTS _tier2_deferred)
  cmake_language(DEFER GET_CALL "${_call}" _command)
  list(GET _command 0 _function)
  if(_function STREQUAL "_obs_build_speed_run")
    cmake_language(DEFER CANCEL_CALL "${_call}")
  endif()
endforeach()
cmake_language(DEFER CALL _obs_windows_tier2_native_build_speed "${CMAKE_CURRENT_SOURCE_DIR}")
endfunction()
