# Dependency headers are not subject to OBS's warning policy (BUILD.md, #2625).
# Keep the original include lists; SYSTEM is a classification, not a new root.
include_guard(GLOBAL)
if(DEFINED OBS_SOURCE_ROOT)
  set_property(GLOBAL PROPERTY OBS_THIRD_PARTY_SOURCE_ROOT "${OBS_SOURCE_ROOT}")
else()
  set_property(GLOBAL PROPERTY OBS_THIRD_PARTY_SOURCE_ROOT "${CMAKE_SOURCE_DIR}")
endif()

function(_obs_third_party_header_directory directory out)
  # Build-interface paths are common on native vendored dependency targets.
  string(REGEX REPLACE "^\\$<BUILD_INTERFACE:(.*)>$" "\\1" _path "${directory}")
  string(REGEX REPLACE "^\\$<\\$<[^>]+>:(.*)>$" "\\1" _path "${_path}")
  set(${out} FALSE PARENT_SCOPE)
  if(NOT IS_ABSOLUTE "${_path}" OR _path MATCHES "\\$<")
    return()
  endif()
  if(EXISTS "${_path}")
    file(REAL_PATH "${_path}" _path)
  else()
    cmake_path(NORMAL_PATH _path)
  endif()
  get_property(_root GLOBAL PROPERTY OBS_THIRD_PARTY_SOURCE_ROOT)
  file(RELATIVE_PATH _relative "${_root}" "${_path}")
  if(_relative MATCHES "^(\\.deps|deps|plugins/decklink/(linux|mac|win)/decklink-sdk)(/|$)")
    set(${out} TRUE PARENT_SCOPE)
  endif()
endfunction()

function(_obs_system_dependency_headers directory)
  get_property(_targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
  foreach(_target IN LISTS _targets)
    foreach(_property IN ITEMS INCLUDE_DIRECTORIES INTERFACE_INCLUDE_DIRECTORIES)
      get_target_property(_includes ${_target} ${_property})
      foreach(_include IN LISTS _includes)
        _obs_third_party_header_directory("${_include}" _third_party)
        if(_third_party)
          if(_property STREQUAL INTERFACE_INCLUDE_DIRECTORIES)
            set_property(TARGET ${_target} APPEND PROPERTY INTERFACE_SYSTEM_INCLUDE_DIRECTORIES "${_include}")
          else()
            target_include_directories(${_target} SYSTEM PRIVATE "${_include}")
          endif()
        endif()
      endforeach()
    endforeach()
  endforeach()
  get_property(_children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
  foreach(_child IN LISTS _children)
    # Submodules retain their own build policy.
    if(NOT _child MATCHES "/plugins/(obs-browser|obs-websocket)(/|$)")
      _obs_system_dependency_headers("${_child}")
    endif()
  endforeach()
endfunction()

# Inspect the completed target graph, including vendored interface libraries.
cmake_language(DEFER CALL _obs_system_dependency_headers "${CMAKE_SOURCE_DIR}")
