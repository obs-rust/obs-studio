#!/usr/bin/env -S uv run --script
"""Lint lane of the local gate (`ci/local_gate.py`). Pass `--fix` to rewrite files.

    ./lint [--fix] [gate arguments]

Kept as an entry point because AGENTS.md and the worker skill document it; the
lane itself is `ci/local_gate.py --lane lint`. A Python (not `sh`) launcher, so
GEN-005 has no shell shebang to flag.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

GATE = Path(__file__).resolve().parent / "ci" / "local_gate.py"


def main() -> int:
    os.execvp("uv", ["uv", "run", str(GATE), "--lane", "lint", *sys.argv[1:]])
    return 0  # unreachable: execvp replaces this process


if __name__ == "__main__":
    sys.exit(main())
