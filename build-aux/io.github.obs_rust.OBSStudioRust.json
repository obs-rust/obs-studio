{
    "id": "io.github.obs_rust.OBSStudioRust",
    "runtime": "org.freedesktop.Platform",
    "runtime-version": "26.08",
    "sdk": "org.freedesktop.Sdk",
    "command": "obs-studio-rust-gui",
    "finish-args": [
        "--socket=wayland",
        "--socket=fallback-x11",
        "--socket=pulseaudio",
        "--device=all",
        "--share=network",
        "--share=ipc",
        "--filesystem=xdg-run/pipewire-0",
        "--filesystem=host",
        "--talk-name=org.kde.StatusNotifierWatcher",
        "--talk-name=org.freedesktop.Flatpak",
        "--talk-name=org.freedesktop.Notifications",
        "--talk-name=org.a11y.Bus",
        "--env=VST_PATH=/app/extensions/Plugins/vst"
    ],
    "add-extensions": {
        "io.github.obs_rust.OBSStudioRust.Plugin": {
            "directory": "plugins",
            "versions": "stable;test",
            "subdirectories": true,
            "add-ld-path": "lib",
            "merge-dirs": "lib/obs-modules/plugins;share/obs/obs-modules/plugins;lib/obs-plugins;share/obs/obs-plugins",
            "no-autodownload": true,
            "autodelete": true
        },
        "org.freedesktop.LinuxAudio.Plugins": {
            "directory": "extensions/Plugins",
            "version": "26.08",
            "add-ld-path": "lib",
            "merge-dirs": "vst",
            "subdirectories": true,
            "no-autodownload": true
        }
    },
    "modules": [
        {
            "name": "obs-deps-buildstream-base",
            "buildsystem": "simple",
            "build-commands": [
                "tar -xvf base.tar.xz -C /"
            ],
            "sources": [
                {
                    "type": "file",
                    "dest-filename": "base.tar.xz",
                    "url": "https://github.com/obs-rust/obs-deps-buildstream/releases/download/2026-10-25/flatpak-base-x86_64-2026-10-25.tar.xz",
                    "sha256": "b081928cda9e75ccdc0b9664f38f8f05589f5b51fc5d5fe51ecb53219be6b498"
                }
            ]
        },
        {
            "name": "obs-deps-buildstream-devel",
            "buildsystem": "simple",
            "build-commands": [
                "tar -xvf devel.tar.xz -C /"
            ],
            "sources": [
                {
                    "type": "file",
                    "dest-filename": "devel.tar.xz",
                    "url": "https://github.com/obs-rust/obs-deps-buildstream/releases/download/2026-10-25/flatpak-devel-x86_64-2026-10-25.tar.xz",
                    "sha256": "6c834f5bcb1b0480dc4cd4b0a53540977821a6b3b38116a83f3875c8b6250737"
                }
            ]
        },
        {
            "name": "obs-deps-buildstream-devtools",
            "buildsystem": "simple",
            "build-commands": [
                "tar -xvf devtools.tar.xz -C /"
            ],
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "file",
                    "dest-filename": "devtools.tar.xz",
                    "url": "https://github.com/obs-rust/obs-deps-buildstream/releases/download/2026-10-25/flatpak-devtools-x86_64-2026-10-25.tar.xz",
                    "sha256": "f5ba4578cade6bfd3670340e7eeb0f31876b39e29bc978b5ed47da7de03ffc70"
                }
            ]
        },
        {
            "name": "obs-deps-buildstream-qt",
            "buildsystem": "simple",
            "build-commands": [
                "tar -xvf qt.tar.xz -C /"
            ],
            "sources": [
                {
                    "type": "file",
                    "dest-filename": "qt.tar.xz",
                    "url": "https://github.com/obs-rust/obs-deps-buildstream/releases/download/2026-10-25/flatpak-qt-x86_64-2026-10-25.tar.xz",
                    "sha256": "af0f8bd96f1958ca3ca29dd7b74d3da65a07e16e193bd6975b70cc77cd6c0b5b"
                }
            ]
        },
        {
            "name": "cef",
            "build-options": {
                "no-debuginfo": true
            },
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/cef/libcef_dll_wrapper",
                "cp -R ./include /app/cef",
                "cp -R ./Release /app/cef",
                "cp -R ./Resources /app/cef",
                "cp -R ./build/libcef_dll_wrapper/libcef_dll_wrapper.a /app/cef/libcef_dll_wrapper",
                "eu-elfcompress -t zstd /app/cef/Release/libcef.so"
            ],
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/obs-rust/cef/releases/download/8078/cef_binary_8078_linux_x86_64.tar.xz",
                    "sha256": "fb36df11bc8280c9cb666732becc1fe267f833bb964dbb13d69cad33488171dc"
                }
            ]
        },
        {
            "name": "obs-rust-toolchain",
            "buildsystem": "simple",
            "build-commands": [
                "./install.sh --prefix=/app/rust --components=rustc,cargo,rust-std-x86_64-unknown-linux-gnu --disable-ldconfig"
            ],
            "cleanup": [
                "*"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://static.rust-lang.org/dist/rust-1.98.1-x86_64-unknown-linux-gnu.tar.xz",
                    "sha256": "5326b36c53de11d148c8f8dab6553a3d1006c2cfd32123683073fad3c302605b"
                }
            ],
            "build-options": {
                "strip": false,
                "no-debuginfo": true
            }
        },
        {
            "name": "obs",
            "buildsystem": "cmake-ninja",
            "builddir": true,
            "config-opts": [
                "-DCMAKE_BUILD_TYPE=RelWithDebInfo",
                "-DENABLE_CCACHE=ON",
                "-DCMAKE_CXX_SCAN_FOR_MODULES=OFF",
                "-DCMAKE_C_COMPILER=/usr/bin/cc",
                "-DCMAKE_CXX_COMPILER=/usr/bin/c++",
                "-DCMAKE_INCLUDE_PATH=/app/include;/usr/include",
                "-DENABLE_FLATPAK=ON",
                "-DENABLE_GPU_STATUS=OFF",
                "-DENABLE_WAYLAND=ON",
                "-DENABLE_BROWSER=ON",
                "-DCEF_ROOT_DIR=/app/cef",
                "-DENABLE_ALSA=OFF",
                "-DENABLE_PULSEAUDIO=ON",
                "-DENABLE_JACK=ON",
                "-DENABLE_VLC=OFF",
                "-DENABLE_AJA=ON",
                "-DENABLE_LIBFDK=ON",
                "-DENABLE_QSV11=ON",
                "-DENABLE_DECKLINK=OFF",
                "-DOBS_BRAND_RUST=ON",
                "-DOBS_LIBOBS_BACKEND=HYBRID",
                "-DFETCHCONTENT_SOURCE_DIR_CORROSION=/run/build/obs/.flatpak-rust/corrosion"
            ],
            "secret-opts": [
                "-DRESTREAM_CLIENTID=$RESTREAM_CLIENTID",
                "-DRESTREAM_HASH=$RESTREAM_HASH",
                "-DTWITCH_CLIENTID=$TWITCH_CLIENTID",
                "-DTWITCH_HASH=$TWITCH_HASH",
                "-DYOUTUBE_CLIENTID=$YOUTUBE_CLIENTID",
                "-DYOUTUBE_CLIENTID_HASH=$YOUTUBE_CLIENTID_HASH",
                "-DYOUTUBE_SECRET=$YOUTUBE_SECRET",
                "-DYOUTUBE_SECRET_HASH=$YOUTUBE_SECRET_HASH"
            ],
            "post-install": [
                "install -d /app/plugins",
                "install -d /app/extensions/Plugins"
            ],
            "sources": [
                {
                    "type": "dir",
                    "path": "../"
                },
                {
                    "type": "archive",
                    "url": "https://github.com/corrosion-rs/corrosion/archive/refs/tags/v0.5.2.tar.gz",
                    "sha256": "6bc02411e29183a896aa60c58db6819ec6cf57c08997481d0b0da9029356b529",
                    "dest": ".flatpak-rust/corrosion"
                }
            ],
            "build-options": {
                "no-debuginfo-compression": true,
                "append-path": "/app/rust/bin",
                "env": {
                    "CARGO_HOME": "/run/build/obs/.flatpak-rust/cargo",
                    "CARGO_NET_OFFLINE": "true",
                    "CCACHE_DEPEND": "true",
                    "CCACHE_COMPILERCHECK": "content"
                }
            }
        }
    ]
}
