#!/bin/sh
# AppRun for the OBS Studio (obs-rust) AppImage.
#
# The AppImage ships its own glibc, so every executable in it has its ELF
# interpreter patched to @LOADER@ (a fixed path chosen at build time; the
# kernel cannot expand variables there). This script makes sure a copy of the
# bundled dynamic loader exists at that path before starting OBS. Keeping the
# kernel in charge of the loader (instead of running `ld.so obs`) keeps
# /proc/self/exe pointing at the real binary, which OBS uses to find its data
# and plugins, and it makes helper processes (obs-ffmpeg-mux, ...) work too.
HERE="$(dirname "$(readlink -f "$0")")"
LOADER="@LOADER@"
LOADER_DIR="$(dirname "$LOADER")"
BUNDLED_LOADER="$HERE/lib64/ld-linux-x86-64.so.2"
GLIBC_DIR="$HERE/glibc"

# glibc, libstdc++ and libgcc_s: the host's when they are at least as new as the
# bundled ones, the bundled ones otherwise (obs-rust/obs-studio#621). The host's
# Mesa and LLVM are built against the host's C and C++ runtime and cannot load
# against an older one; but an older host (Ubuntu 22.04, ...) cannot run what
# was built here. Every ELF file's RPATH ends with $LOADER_DIR/lib: filled with
# the bundled copies, or left empty so that the host's are found.
# (OBS_APPIMAGE_BUNDLED_LIBC=1 forces the bundled ones.)
host_loader=""
for c in /lib64/ld-linux-x86-64.so.2 /usr/lib64/ld-linux-x86-64.so.2 \
    /lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 /usr/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 \
    /usr/lib/ld-linux-x86-64.so.2 /lib/ld-linux-x86-64.so.2; do
    [ -x "$c" ] && { host_loader="$(readlink -f "$c")"; break; }
done
# "major.minor" -> a comparable number
ver_num() { echo "$1" | awk -F. '{ printf "%d", $1 * 1000 + $2 }'; }
use_host_libc=0
if [ -n "$host_loader" ] && [ -z "$OBS_APPIMAGE_BUNDLED_LIBC" ]; then
    host_glibc="$("$host_loader" --version 2>/dev/null | sed -n '1s/.*release version \([0-9][0-9]*\.[0-9][0-9]*\).*/\1/p')"
    host_stdcxx=""
    for d in /usr/lib64 /usr/lib/x86_64-linux-gnu /usr/lib /lib64 /lib/x86_64-linux-gnu /lib; do
        if [ -r "$d/libstdc++.so.6" ] && [ -r "$d/libgcc_s.so.1" ]; then
            host_stdcxx="$(grep -a -o 'GLIBCXX_3\.4\.[0-9]*' "$d/libstdc++.so.6" 2>/dev/null | sed 's/.*\.//' | sort -n | tail -1)"
            break
        fi
    done
    if [ -n "$host_glibc" ] && [ -n "$host_stdcxx" ] &&
        [ "$(ver_num "$host_glibc")" -ge "$(ver_num "$(cat "$GLIBC_DIR/GLIBC_VERSION")")" ] &&
        [ "$host_stdcxx" -ge "$(cat "$GLIBC_DIR/GLIBCXX_MINOR")" ]; then
        use_host_libc=1
    fi
fi
if [ "$use_host_libc" = 1 ]; then
    MODE=host
    SOURCE_LOADER="$host_loader"
else
    MODE=bundled
    SOURCE_LOADER="$BUNDLED_LOADER"
fi

# Only coreutils here: minimal containers lack cmp, find, ...
same_loader() {
    [ -f "$LOADER" ] && [ "$(sha256sum <"$SOURCE_LOADER")" = "$(sha256sum <"$LOADER")" ]
}
umask 022
mkdir -p "$LOADER_DIR" 2>/dev/null
if ! same_loader; then
    tmp="$(mktemp "$LOADER_DIR/.ld.XXXXXX" 2>/dev/null)" &&
        cp "$SOURCE_LOADER" "$tmp" && chmod 755 "$tmp" &&
        mv -f "$tmp" "$LOADER"
fi
# Never trust a loader directory someone else owns or can write to: it is
# executed as the interpreter of every process we start.
owner="$(stat -c %u "$LOADER_DIR" 2>/dev/null)"
mode="$(stat -c %a "$LOADER_DIR" 2>/dev/null)"
case "$mode" in
*[2367]? | *[2367]) writable=1 ;;
*) writable=0 ;;
esac
if ! same_loader || [ "$writable" = 1 ] || { [ "$owner" != "$(id -u)" ] && [ "$owner" != 0 ]; }; then
    echo "obs AppImage: cannot set up the bundled loader in $LOADER_DIR" >&2
    echo "(the directory must be writable by you only and /tmp must allow exec)" >&2
    exit 1
fi
# The libraries behind the RPATH entry: copies (the AppImage mounts at a new
# place every time, so links into it would dangle for a running instance).
if [ "$MODE" = host ]; then
    rm -rf "$LOADER_DIR/lib" 2>/dev/null
elif [ ! -e "$LOADER_DIR/lib/.complete" ]; then
    rm -rf "$LOADER_DIR/lib" "$LOADER_DIR/lib.new" 2>/dev/null
    if mkdir "$LOADER_DIR/lib.new" &&
        for f in "$GLIBC_DIR"/*.so*; do cp "$f" "$LOADER_DIR/lib.new/" || exit 1; done &&
        : >"$LOADER_DIR/lib.new/.complete" &&
        mv "$LOADER_DIR/lib.new" "$LOADER_DIR/lib"; then
        :
    else
        echo "obs AppImage: cannot copy the bundled C library to $LOADER_DIR/lib" >&2
        exit 1
    fi
fi
echo "$MODE" >"$LOADER_DIR/mode" 2>/dev/null

export APPDIR="$HERE"
# Deliberately NO LD_LIBRARY_PATH: every bundled ELF carries a relative RPATH
# (set-runpaths.sh). An exported LD_LIBRARY_PATH would leak into every process
# OBS spawns, and host programs crash when they pick up the bundled glibc.
export QT_PLUGIN_PATH="$HERE/usr/lib/qt6/plugins"
export QT_QPA_PLATFORM_PLUGIN_PATH="$HERE/usr/lib/qt6/plugins/platforms"
export GCONV_PATH="$HERE/usr/lib/gconv"
export XDG_DATA_DIRS="$HERE/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"
export SPA_PLUGIN_DIR="$HERE/usr/lib/spa-0.2"
export PIPEWIRE_MODULE_DIR="$HERE/usr/lib/pipewire-0.3"
export PIPEWIRE_CONFIG_DIR="$HERE/usr/share/pipewire"
# Host driver search paths. Never point the host stack at bundled drivers or
# replace a user's selection. Nix exposes its driver closure under /run.
host_driver_dirs() {
    driver_dirs=""
    for driver_dir in "$@"; do
        if [ -d "$driver_dir" ]; then
            driver_dirs="${driver_dirs:+$driver_dirs:}$driver_dir"
        fi
    done
    printf '%s' "$driver_dirs"
}
if [ -z "${GBM_BACKENDS_PATH:-}" ]; then
    GBM_BACKENDS_PATH="$(host_driver_dirs /run/opengl-driver/lib/gbm \
        /usr/lib/x86_64-linux-gnu/gbm /usr/lib64/gbm /usr/lib/gbm)"
    if [ -n "$GBM_BACKENDS_PATH" ]; then export GBM_BACKENDS_PATH; fi
fi
if [ -z "${LIBVA_DRIVERS_PATH:-}" ]; then
    LIBVA_DRIVERS_PATH="$(host_driver_dirs /run/opengl-driver/lib/dri \
        /usr/lib/x86_64-linux-gnu/dri /usr/lib64/dri /usr/lib/dri)"
    if [ -n "$LIBVA_DRIVERS_PATH" ]; then export LIBVA_DRIVERS_PATH; fi
fi
if [ -z "${__EGL_VENDOR_LIBRARY_DIRS:-}" ] && [ -z "${__EGL_VENDOR_LIBRARY_FILENAMES:-}" ]; then
    __EGL_VENDOR_LIBRARY_DIRS="$(host_driver_dirs /run/opengl-driver/share/glvnd/egl_vendor.d \
        /etc/glvnd/egl_vendor.d /usr/share/glvnd/egl_vendor.d)"
    if [ -n "$__EGL_VENDOR_LIBRARY_DIRS" ]; then export __EGL_VENDOR_LIBRARY_DIRS; fi
fi
if [ -z "${__EGL_EXTERNAL_PLATFORM_CONFIG_DIRS:-}" ] && [ -z "${__EGL_EXTERNAL_PLATFORM_CONFIG_FILENAMES:-}" ]; then
    __EGL_EXTERNAL_PLATFORM_CONFIG_DIRS="$(host_driver_dirs /run/opengl-driver/share/egl/egl_external_platform.d \
        /etc/egl/egl_external_platform.d /usr/share/egl/egl_external_platform.d)"
    if [ -n "$__EGL_EXTERNAL_PLATFORM_CONFIG_DIRS" ]; then export __EGL_EXTERNAL_PLATFORM_CONFIG_DIRS; fi
fi
# VK_DRIVER_FILES also accepts directories. Honour the older override too.
if [ -z "${VK_DRIVER_FILES:-}" ] && [ -z "${VK_ICD_FILENAMES:-}" ]; then
    VK_DRIVER_FILES="$(host_driver_dirs /run/opengl-driver/share/vulkan/icd.d \
        /etc/vulkan/icd.d /usr/share/vulkan/icd.d)"
    if [ -n "$VK_DRIVER_FILES" ]; then export VK_DRIVER_FILES; fi
fi
# gconv modules belong to the glibc that runs them
[ "$MODE" = host ] && unset GCONV_PATH
# Host certificate bundles live in different places per distribution.
if [ -z "$SSL_CERT_FILE" ]; then
    for f in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
        /etc/ssl/ca-bundle.pem /etc/ssl/cert.pem; do
        [ -r "$f" ] && { export SSL_CERT_FILE="$f"; break; }
    done
fi
# Never let the host inject modules built against its own (different) Qt/GLib:
# usr/bin/qt.conf pins Qt's plugin search to the bundle, and GIO/GSettings
# modules (dconf, gvfs, ...) are loaded from an empty bundled directory only.
unset QT_QPA_PLATFORMTHEME QT_STYLE_OVERRIDE QT_IM_MODULE QT_QPA_PLATFORM_PLUGIN_PATH_HOST
export GIO_MODULE_DIR="$HERE/usr/lib/gio/modules"
export GIO_USE_VFS=local
export GSETTINGS_BACKEND=memory

if [ -n "$OBS_APPIMAGE_DEBUG" ]; then
    # Troubleshooting: OBS_APPIMAGE_DEBUG=1 ./OBS-Studio-*-linux-x86_64.AppImage
    # prints the environment and, when gdb is installed, a backtrace of a crash.
    echo "== AppImage environment ==" >&2
    env | sort | grep -E '^(APPDIR|GBM_|LIBVA|VK_|__EGL|LD_|QT_|GIO_|GSETTINGS_|XDG_|WAYLAND|DISPLAY|DBUS|LANG|LC_)' >&2
    export QT_DEBUG_PLUGINS=1 LIBGL_DEBUG=verbose EGL_LOG_LEVEL=debug
    if command -v gdb >/dev/null 2>&1; then
        exec gdb -q -batch -ex 'set pagination off' -ex 'handle SIGPIPE nostop noprint' -ex run \
            -ex 'echo \n== backtrace ==\n' -ex bt -ex 'thread apply all bt 30' \
            --args "$HERE/usr/bin/@OBS_GUI_NAME@" "$@"
    fi
    echo "gdb not found; install it to get a backtrace" >&2
fi

# Run OBS as a child (not exec) so that a crash can be reported instead of
# vanishing as a bare "exited with status 11" from the desktop's launcher.
started="$(date +%s)"
"$HERE/usr/bin/@OBS_GUI_NAME@" "$@" &
child=$!
trap 'kill -TERM "$child" 2>/dev/null' TERM INT HUP
wait "$child"
rc=$?
while kill -0 "$child" 2>/dev/null; do wait "$child"; rc=$?; done
trap - TERM INT HUP

case "$rc" in
132 | 134 | 135 | 136 | 139)
    sig="$(kill -l $((rc - 128)))"
    report="${XDG_CACHE_HOME:-$HOME/.cache}/obs-studio-appimage-crash.txt"
    mkdir -p "$(dirname "$report")" 2>/dev/null
    {
        echo "OBS Studio AppImage crashed with SIG$sig (exit status $rc) at $(date)"
        echo "after $(($(date +%s) - started)) seconds"
        echo
        echo "== system =="
        uname -a
        grep -E '^(PRETTY_NAME|ID)=' /etc/os-release 2>/dev/null
        echo "session: ${XDG_SESSION_TYPE:-?} DISPLAY=${DISPLAY:-} WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
        echo "/dev/dri: $(ls /dev/dri 2>/dev/null | tr '\n' ' ')"
        echo
        echo "== bundled loader =="
        echo "$LOADER"
        echo
        echo "== relevant environment =="
        env | grep -E '^(LD_|LIBVA|LIBGL|MESA|EGL|__GL|QT_|GIO_|GSETTINGS|XDG_SESSION|LANG|LC_)' | sort
        echo
        echo "== last lines of the newest OBS log (it is buffered, so it may be short) =="
        log="$(ls -1t "${XDG_CONFIG_HOME:-$HOME/.config}"/obs-studio/logs/* 2>/dev/null | head -1)"
        echo "$log"
        [ -n "$log" ] && tail -n 60 "$log"
    } >"$report" 2>&1
    echo "OBS crashed (SIG$sig). A report was saved to: $report" >&2
    # A crash right after start is reproducible: run OBS once more under gdb and
    # add the backtrace to the report. (If it starts fine this time, it just runs.)
    if [ $(($(date +%s) - started)) -lt 120 ] && command -v gdb >/dev/null 2>&1; then
        echo "Restarting OBS under gdb to capture a backtrace..." >&2
        gdb -q -batch -ex 'set pagination off' -ex 'handle SIGPIPE nostop noprint' -ex run \
            -ex 'echo \n== backtrace ==\n' -ex bt -ex 'thread apply all bt 30' -ex 'info sharedlibrary' \
            --args "$HERE/usr/bin/@OBS_GUI_NAME@" "$@" >>"$report" 2>&1 </dev/null
        rc=$?
        echo "A backtrace (if it crashed again) was added to: $report" >&2
    else
        echo "Install gdb and start again to get a backtrace, or run with OBS_APPIMAGE_DEBUG=1" >&2
    fi
    ;;
esac
exit "$rc"
