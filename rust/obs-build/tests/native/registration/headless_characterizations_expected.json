{
    "schema": 1,
    "targets": {
        "test_wayland_hotkeys": {
            "sources": [
                "test/cmocka/test_wayland_hotkeys.c",
                "libobs/obs-hotkey-binding-press.c.h",
                "libobs/obs-hotkey-background-query.c.h",
                "libobs/obs-hotkey.c.h",
                "libobs/obs-hotkey-background-enum.c.h",
                "libobs/obs-hotkey-enum.c.h",
                "libobs/obs-hotkey-save-load.c.h",
                "libobs/obs-hotkey-bindings.c.h",
                "libobs/obs-hotkey-translations.c.h",
                "libobs/obs-hotkey-press.c.h",
                "libobs/obs-hotkey-pair.c.h",
                "libobs/obs-nix-hotkey-state.c.h"
            ],
            "requires": {
                "any": [
                    "OS_LINUX",
                    "OS_FREEBSD"
                ]
            },
            "definitions": [
                "obs=hotkey_test_obs"
            ],
            "includes": [
                "libobs"
            ],
            "watch_inputs": [
                "libobs/build/libobs.pch.h",
                "libobs/build/libobs-nix.pch.h"
            ],
            "libraries": [
                "OBS::libobs",
                "OBS::caption",
                "OBS::native-test-cmocka"
            ]
        },
        "test_service_state": {
            "sources": [
                "test/cmocka/test_service_state.c"
            ],
            "header_libraries": [
                "OBS::headless-characterization-headers"
            ],
            "includes": [
                "deps/libcaption"
            ],
            "watch_inputs": [
                "libobs/obs-service-state.c.h"
            ],
            "libraries": [
                "OBS::libobs",
                {
                    "name": "OBS::w32-pthreads",
                    "requires": "OS_WINDOWS"
                },
                "OBS::native-test-cmocka"
            ]
        },
        "test_lua_graphics_lock": {
            "sources": [
                "test/cmocka/test_lua_graphics_lock.c"
            ],
            "header_libraries": [
                "OBS::headless-characterization-headers"
            ],
            "watch_inputs": [
                "test/cmocka/fixtures/lua-graphics-lock-original.h"
            ],
            "libraries": [
                "OBS::native-test-cmocka"
            ]
        },
        "test_lua_graphics_lock_bounded": {
            "sources": [
                "test/cmocka/test_lua_graphics_lock_bounded.c"
            ],
            "header_libraries": [
                "OBS::headless-characterization-headers"
            ],
            "watch_inputs": [
                "shared/obs-scripting/obs-scripting-lua-source.c.h"
            ],
            "libraries": [
                "OBS::native-test-cmocka",
                {
                    "name": "OBS::w32-pthreads",
                    "requires": "OS_WINDOWS"
                },
                {
                    "name": "Threads::Threads",
                    "requires": {
                        "not": "OS_WINDOWS"
                    }
                }
            ]
        },
        "test_vcam_audio_config": {
            "sources": [
                "frontend/tests/test_vcam_audio_config.cpp"
            ],
            "requires": "HAVE_FRONTEND_PLAIN_TEST_OWNER",
            "watch_inputs": [
                "frontend/utility/VCamAudio.hpp"
            ]
        },
        "test_virtual_cam_shutdown": {
            "sources": [
                "frontend/tests/test_virtual_cam_shutdown.cpp"
            ],
            "requires": "HAVE_FRONTEND_PLAIN_TEST_OWNER",
            "watch_inputs": [
                "frontend/widgets/VirtualCamShutdown.hpp"
            ]
        }
    },
    "tests": {
        "test_wayland_hotkeys": {
            "target": "test_wayland_hotkeys",
            "command": [
                "${target}"
            ],
            "requires": {
                "any": [
                    "OS_LINUX",
                    "OS_FREEBSD"
                ]
            }
        },
        "test_service_state": {
            "target": "test_service_state",
            "command": [
                "${target}"
            ]
        },
        "test_lua_graphics_lock": {
            "target": "test_lua_graphics_lock",
            "command": [
                "${target}"
            ],
            "timeout_seconds": 10
        },
        "test_lua_graphics_lock_bounded": {
            "target": "test_lua_graphics_lock_bounded",
            "command": [
                "${target}"
            ],
            "timeout_seconds": 10
        },
        "test_vcam_audio_config": {
            "target": "test_vcam_audio_config",
            "command": [
                "${target}"
            ],
            "requires": "HAVE_FRONTEND_PLAIN_TEST_OWNER"
        },
        "test_virtual_cam_shutdown": {
            "target": "test_virtual_cam_shutdown",
            "command": [
                "${target}"
            ],
            "requires": "HAVE_FRONTEND_PLAIN_TEST_OWNER"
        }
    }
