  "tests": {
    "obs_runtime_bench_smoke": {
      "target": "obs_runtime_bench",
      "command": [
        "${target}",
        "--seconds",
        "1",
        "--warmup",
        "0.5"
      ],
      "working_directory": "${runtime}",
      "timeout_seconds": 60,
      "skip_return_code": 77,
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_X11_DISPLAY",
          "HAVE_OBS_OPENGL"
        ]
      },
      "suite": "graphics"
    },
    "test_media_cover_art_monitor": {
      "target": "test_media_cover_art_monitor",
      "working_directory": "${runtime}",
      "timeout_seconds": 120,
      "resource_locks": [
        "timing"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_X11_DISPLAY",
          "HAVE_OBS_OPENGL",
          "HAVE_MEDIA_PLAYBACK_TEST_OWNER"
        ]
      },
      "suite": "graphics"
    },
    "test_media_sync_offset_restart": {
      "target": "test_media_sync_offset_restart",
      "working_directory": "${runtime}",
      "timeout_seconds": 120,
      "resource_locks": [
        "timing"
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_X11_DISPLAY",
          "HAVE_OBS_OPENGL",
          "HAVE_MEDIA_PLAYBACK_TEST_OWNER"
        ]
      },
      "suite": "graphics"
    },
    "test_screencast_portal_teardown": {
      "target": "test_screencast_portal_teardown",
      "timeout_seconds": 60,
      "environment": {
        "PORTAL_TEST_VERBOSE": "1"
      },
      "skip_return_code": 77,
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_X11_DISPLAY",
          "HAVE_OBS_PIPEWIRE"
        ]
      },
      "suite": "graphics"
    },
    "test_stinger_media_duration": {
      "target": "test_stinger_media_duration",
      "working_directory": "${runtime}",
      "timeout_seconds": 120,
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_X11_DISPLAY",
          "HAVE_OBS_OPENGL",
          "HAVE_MEDIA_PLAYBACK_TEST_OWNER",
          "HAVE_TRANSITIONS_TEST_OWNER"
        ]
      },
      "suite": "graphics"
    },
    "test_xshm_capture_live": {
      "target": "test_xshm_capture_live",
      "working_directory": "${runtime}",
      "timeout_seconds": 30,
      "environment": {
        "LP_NUM_THREADS": "1"
      },
      "optional_prefixes": [
        [
          "xvfb-run",
          "-a",
          "--server-args=-screen 0 1280x1024x24 -noreset"
        ]
      ],
      "requires": {
        "all": [
          "OS_LINUX",
          "HAVE_X11_DISPLAY",
          "HAVE_OBS_OPENGL",
          "HAVE_LINUX_CAPTURE"
        ]
      },
      "suite": "graphics"
    }
  }
