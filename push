#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Push a branch the way CI expects: attest, stamp, push, then open the PR.

This is the single entry point agents should use:

    ./push -> prooft run client-lint / client-test-HOST -> final sign/verify -> push -> PR

The repository lanes run formatting, ratchets and self-tests, clippy + Dylint
for all six shipping targets, and native workspace Tiers 1-3. prooft writes
only successful gate evidence. The deprecated soldr+ghd fallback proves partial
host checks only. Missing evidence or signing defaults to ordinary PR CI;
PUSH_REQUIRE_ATTESTATION=1 refuses incomplete evidence before any push.

Exit codes: 0 pushed, 1 a step failed, 2 usage, 3 refused (dirty tree or missing
evidence under PUSH_REQUIRE_ATTESTATION).
"""

from __future__ import annotations

import os
import json
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT / "ci"))
from local_gate import CLIENT_TARGETS, client_gates, host_target

REQUIRE = os.environ.get("PUSH_REQUIRE_ATTESTATION") == "1"


def run(args: list[str], *, capture: bool = False, check: bool = True) -> subprocess.CompletedProcess[str]:
    """Run one command, echoing it so the agent's log shows the real pipeline."""

    print(f"+ {' '.join(args)}", flush=True)
    return subprocess.run(
        args,
        cwd=ROOT,
        text=True,
        capture_output=capture,
        check=check,
    )


def git(*args: str, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return run(["git", *args], capture=capture)


def supports(args: list[str], needle: str) -> bool:
    """Whether an installed tool advertises a subcommand or flag we depend on."""

    proc = subprocess.run(args, cwd=ROOT, text=True, capture_output=True)
    return needle in (proc.stdout or "") + (proc.stderr or "")


def dirty() -> bool:
    return bool(git("status", "--porcelain", capture=True).stdout.strip())


PROOFT_MIN_VERSION = (0, 1, 0)


def _prooft_version(tool: str) -> tuple[int, int, int] | None:
    """(major, minor, patch) from `prooft --version`, or None when unknown."""

    proc = subprocess.run([tool, "--version"], text=True, capture_output=True)
    if proc.returncode != 0:
        return None
    digits = [part for part in (proc.stdout + proc.stderr).replace("v", " ").split() if part[:1].isdigit()]
    if not digits:
        return None
    parts = digits[0].split(".")
    try:
        numbers = tuple(int(p) for p in parts[:3])
    except ValueError:
        return None
    return (numbers + (0, 0, 0))[:3]


ATTEST_KEEP = 20
ATTEST_MAX_AGE_DAYS = 7


def evidence_path() -> Path:
    """A per-commit evidence file, pruned periodically.

    One file per commit, never a singleton: two agents pushing from the same
    clone (or a worktree whose `.git` is a file) must not overwrite each
    other's evidence. Pruning keeps the directory bounded -- it is scratch, not
    a record, and the attestation itself lives in the commit message.
    """

    git_dir = Path(git("rev-parse", "--git-dir", capture=True).stdout.strip() or ".git")
    sha = git("rev-parse", "HEAD", capture=True).stdout.strip() or "HEAD"
    directory = git_dir / "soldr-attest"
    directory.mkdir(parents=True, exist_ok=True)
    prune_evidence(directory)
    return directory / f"{sha.replace('/', '-')}.json"


def prune_evidence(directory: Path) -> None:
    """Drop stale evidence: older than a week, then all but the newest few."""

    import time

    now = time.time()
    files = sorted(directory.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    for index, path in enumerate(files):
        age_days = (now - path.stat().st_mtime) / 86400
        if index >= ATTEST_KEEP or age_days > ATTEST_MAX_AGE_DAYS:
            path.unlink(missing_ok=True)


def sign_final() -> bool:
    """Sign after every trailer amendment, using the user's Git signing config.

    No configured key/signing means ordinary PR CI. A signature on the original
    commit is insufficient: prooft's message amendments replace that object.
    """
    key = run(["git", "config", "--get", "user.signingkey"], capture=True, check=False)
    enabled = run(["git", "config", "--get", "commit.gpgsign"], capture=True, check=False)
    if not key.stdout.strip() and enabled.stdout.strip().lower() != "true":
        print("./push: no signing configured; final client stamp is ineligible for the fast path")
        return False
    signed = run(["git", "commit", "--amend", "--no-edit", "-S"], check=False)
    if signed.returncode != 0:
        print("./push: final signing failed; using ordinary PR CI", file=sys.stderr)
        return False
    return run(["git", "verify-commit", "HEAD"], check=False).returncode == 0


def emitted_gates(prooft: str) -> set[str]:
    """Read prooft's validated bundle, never guess coverage from exit zero."""
    proc = run([prooft, "emit"], capture=True, check=False)
    if proc.returncode:
        return set()
    try:
        bundle = json.loads(proc.stdout)
        if bundle.get("v") != 1 or not isinstance(bundle.get("attestations"), list):
            return set()
        return {a["gate"] for a in bundle["attestations"] if isinstance(a, dict) and isinstance(a.get("gate"), str)}
    except (ValueError, TypeError, AttributeError):
        return set()


def complete_prooft(prooft: str, tree: str) -> bool:
    """Run real repository lanes; require their complete validated inventory."""
    host = host_target()
    if host not in CLIENT_TARGETS:
        print(f"./push: unsupported native target {host}; no client evidence", file=sys.stderr)
        return False
    commands = (
        [prooft, "run", "client-lint", "--", "uv", "run", "ci/local_gate.py", "--lane", "client-lint"],
        [prooft, "run", f"client-test-{host}", "--", "uv", "run", "ci/local_gate.py",
         "--lane", "client-test", "--client-target", host],
    )
    for command in commands:
        if run(command, check=False).returncode != 0:
            print("./push: client proof failed or unavailable; partial evidence only, ordinary PR CI", file=sys.stderr)
            return False
        if not unchanged(tree):
            return False
    missing = client_gates(host) - emitted_gates(prooft)
    if missing:
        print(f"./push: incomplete client evidence; missing: {', '.join(sorted(missing))}", file=sys.stderr)
        return False
    if not sign_final() or not unchanged(tree):
        return False
    return not (client_gates(host) - emitted_gates(prooft))


def unchanged(tree: str) -> bool:
    if dirty() or git("rev-parse", "HEAD^{tree}", capture=True).stdout.strip() != tree:
        print("./push: tracked inputs changed; client evidence invalid", file=sys.stderr)
        return False
    return True


def legacy_attest(tree: str) -> bool:
    """Deprecated writer: it can stamp host checks, never full client coverage."""
    soldr = shutil.which("soldr")
    if soldr and supports([soldr, "lint", "--help"], "--attest"):
        evidence = evidence_path()
        proc = run([soldr, "lint", "rust", "--attest", "--format", "json"], capture=True, check=False)
        if proc.returncode != 0:
            print("./push: `soldr lint rust --attest` failed; see its output above", file=sys.stderr)
            return False
        if not unchanged(tree):
            return False
        evidence.write_text(proc.stdout.strip().splitlines()[-1] if proc.stdout.strip() else "{}")
        ghd = shutil.which("ghd")
        if ghd and supports([ghd, "attest", "stamp", "--help"], "--evidence"):
            print("./push: deprecated path: ghd stamps partial host coverage only; no complete client fast path")
            run([ghd, "attest", "stamp", "--evidence", str(evidence)], check=False)
        else:
            print("./push: ghd has no `attest stamp`; no trailer written")
    else:
        print("./push: this soldr has no `lint rust --attest`; no client evidence is produced")
    return False


def attest() -> bool:
    """Return complete, locally verified and signed client coverage only.

    prooft run owns the evidence format and enforces clean, unchanged command
    inputs. Each successful lane stamps its actual checks; a failed/optional
    lane cannot be inferred from a successful older prooft soldr invocation.
    The final stamp is signed only after ALL proof commands have finished.
    """
    if dirty():
        return False
    tree = git("rev-parse", "HEAD^{tree}", capture=True).stdout.strip()
    prooft = shutil.which("prooft")
    if prooft:
        version = _prooft_version(prooft)
        if version is not None and version >= PROOFT_MIN_VERSION:
            return complete_prooft(prooft, tree)
        print(f"./push: prooft {version or 'unknown'} is older than {PROOFT_MIN_VERSION}; skipping it")
    else:
        print("./push: prooft is not installed (uv tool install 'prooft>=0.1'); trying the deprecated path")
    return legacy_attest(tree)


def main(argv: list[str]) -> int:
    branch = git("rev-parse", "--abbrev-ref", "HEAD", capture=True).stdout.strip()
    if branch in {"master", "HEAD"}:
        print("./push: refusing to push from %s; make a branch first" % branch, file=sys.stderr)
        return 3
    if dirty():
        print("./push: working tree is dirty; commit or stash before pushing", file=sys.stderr)
        return 3

    try:
        attested = attest()
    except (OSError, subprocess.CalledProcessError) as exc:
        print(f"./push: client evidence unavailable: {exc}; using ordinary PR CI", file=sys.stderr)
        attested = False
    # A command that dirties the checkout must never publish unproved changes.
    if dirty():
        print("./push: proof commands changed the working tree; refusing to push", file=sys.stderr)
        return 3

    if not attested and REQUIRE:
        print(
            "./push: PUSH_REQUIRE_ATTESTATION=1 but complete signed client evidence is missing; refusing",
            file=sys.stderr,
        )
        return 3

    run(["git", "push", "-u", "origin", branch])

    pr = subprocess.run(
        ["gh", "pr", "view", "--json", "number", "--jq", ".number"],
        cwd=ROOT,
        text=True,
        capture_output=True,
    )
    if pr.returncode != 0 or not pr.stdout.strip():
        title = git("log", "-1", "--format=%s", capture=True).stdout.strip()
        create = ["gh", "pr", "create", "--fill", "--title", title, "--head", branch]
        # Back pressure (ci/backpressure.py): while the merge queue lands fewer
        # PRs than are in flight, or runners are starved, a new PR opens as a
        # draft, so the work is published but takes no queue capacity. Mark it
        # ready once the gate reads open again.
        gate = subprocess.run(
            ["uv", "run", "--no-project", "--script", str(ROOT / "ci" / "backpressure.py"), "--check"],
            cwd=ROOT, text=True, capture_output=True,
        )
        if gate.returncode == 75:
            print(f"./push: {gate.stdout.strip()}; opening the PR as a draft")
            create.append("--draft")
        run(create)
    else:
        print(f"./push: PR #{pr.stdout.strip()} already exists for {branch}")

    if not attested:
        print(
            "./push: pushed without complete signed client evidence; ordinary PR CI remains required."
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
