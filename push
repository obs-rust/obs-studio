#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
"""Push a branch the way CI expects: attest, stamp, push, then open the PR.

This is the single entry point agents should use. It composes three tools that
each do one thing -- `soldr` proves the client-side work, `ghd` writes the
evidence into the commit message, `gh`/`ghd` open the PR -- and refuses to push
a branch whose evidence does not exist yet.

The chain it implements:

    ./push -> soldr lint rust --attest -> ghd attest stamp -> git push -> PR

Two of those tools are newer than this script. When a local toolchain cannot do
its step, `./push` says so plainly and falls back to the pre-existing path (push
the branch and let the local gate stamp it), instead of pretending the evidence
was produced. Set PUSH_REQUIRE_ATTESTATION=1 to make a missing toolchain an
error -- that is the switch for the enforce phase.

Exit codes: 0 pushed, 1 a step failed, 2 usage, 3 refused (dirty tree or missing
evidence under PUSH_REQUIRE_ATTESTATION).
"""

from __future__ import annotations

import os
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent
REQUIRE = os.environ.get("PUSH_REQUIRE_ATTESTATION") == "1"


def run(args: list[str], *, capture: bool = False, check: bool = True) -> subprocess.CompletedProcess[str]:
    """Run one command, echoing it so the agent's log shows the real pipeline."""

    print(f"+ {' '.join(args)}", flush=True)
    return subprocess.run(
        args,
        cwd=ROOT,
        text=True,
        capture_output=capture,
        check=check,
    )


def git(*args: str, capture: bool = False) -> subprocess.CompletedProcess[str]:
    return run(["git", *args], capture=capture)


def supports(args: list[str], needle: str) -> bool:
    """Whether an installed tool advertises a subcommand or flag we depend on."""

    proc = subprocess.run(args, cwd=ROOT, text=True, capture_output=True)
    return needle in (proc.stdout or "") + (proc.stderr or "")


def dirty() -> bool:
    return bool(git("status", "--porcelain", capture=True).stdout.strip())


PROOFT_MIN_VERSION = (0, 1, 0)


def _prooft_version(tool: str) -> tuple[int, int, int] | None:
    """(major, minor, patch) from `prooft --version`, or None when unknown."""

    proc = subprocess.run([tool, "--version"], text=True, capture_output=True)
    if proc.returncode != 0:
        return None
    digits = [part for part in (proc.stdout + proc.stderr).replace("v", " ").split() if part[:1].isdigit()]
    if not digits:
        return None
    parts = digits[0].split(".")
    try:
        numbers = tuple(int(p) for p in parts[:3])
    except ValueError:
        return None
    return (numbers + (0, 0, 0))[:3]


ATTEST_KEEP = 20
ATTEST_MAX_AGE_DAYS = 7


def evidence_path() -> Path:
    """A per-commit evidence file, pruned periodically.

    One file per commit, never a singleton: two agents pushing from the same
    clone (or a worktree whose `.git` is a file) must not overwrite each
    other's evidence. Pruning keeps the directory bounded -- it is scratch, not
    a record, and the attestation itself lives in the commit message.
    """

    git_dir = Path(git("rev-parse", "--git-dir", capture=True).stdout.strip() or ".git")
    sha = git("rev-parse", "HEAD", capture=True).stdout.strip() or "HEAD"
    directory = git_dir / "soldr-attest"
    directory.mkdir(parents=True, exist_ok=True)
    prune_evidence(directory)
    return directory / f"{sha.replace('/', '-')}.json"


def prune_evidence(directory: Path) -> None:
    """Drop stale evidence: older than a week, then all but the newest few."""

    import time

    now = time.time()
    files = sorted(directory.glob("*.json"), key=lambda p: p.stat().st_mtime, reverse=True)
    for index, path in enumerate(files):
        age_days = (now - path.stat().st_mtime) / 86400
        if index >= ATTEST_KEEP or age_days > ATTEST_MAX_AGE_DAYS:
            path.unlink(missing_ok=True)


def attest() -> bool:
    """Stamp this commit's evidence. Returns whether a trailer was written.

    prooft owns the trailer format and the lane rules, so it goes first; the
    hand-rolled soldr+ghd path stays only as a deprecated fallback for
    machines that predate it. A missing writer never invents evidence: it says
    so and lets the push continue unless the caller demanded attestation.
    """

    prooft = shutil.which("prooft")
    if prooft:
        version = _prooft_version(prooft)
        if version is None or version < PROOFT_MIN_VERSION:
            print(f"./push: prooft {version or 'unknown'} is older than {PROOFT_MIN_VERSION}; skipping it")
        else:
            # prooft runs soldr lint's porcelain and stamps the Rust gates it
            # proved, so the evidence and the trailer come from one component.
            stamped = run([prooft, "soldr"], check=False)
            if stamped.returncode == 0:
                return True
            print("./push: prooft soldr failed; see its output above", file=sys.stderr)
            return False
    else:
        print("./push: prooft is not installed (uv tool install 'prooft>=0.1'); trying the deprecated path")

    soldr = shutil.which("soldr")
    if soldr and supports([soldr, "lint", "--help"], "--attest"):
        evidence = evidence_path()
        proc = run([soldr, "lint", "rust", "--attest", "--format", "json"], capture=True, check=False)
        if proc.returncode != 0:
            print("./push: `soldr lint rust --attest` failed; see its output above", file=sys.stderr)
            return False
        evidence.write_text(proc.stdout.strip().splitlines()[-1] if proc.stdout.strip() else "{}")
        ghd = shutil.which("ghd")
        if ghd and supports([ghd, "attest", "stamp", "--help"], "--evidence"):
            print("./push: deprecated path: stamping with ghd instead of prooft")
            return run([ghd, "attest", "stamp", "--evidence", str(evidence)], check=False).returncode == 0
        print("./push: ghd has no `attest stamp`; the commit carries no Ci-Attestation trailer")
    else:
        print("./push: this soldr has no `lint rust --attest`; no client evidence is produced")
    return False


def main(argv: list[str]) -> int:
    branch = git("rev-parse", "--abbrev-ref", "HEAD", capture=True).stdout.strip()
    if branch in {"master", "HEAD"}:
        print("./push: refusing to push from %s; make a branch first" % branch, file=sys.stderr)
        return 3
    if dirty():
        print("./push: working tree is dirty; commit or stash before pushing", file=sys.stderr)
        return 3

    attested = attest()


    if not attested and REQUIRE:
        print(
            "./push: PUSH_REQUIRE_ATTESTATION=1 but no attestation was produced; refusing",
            file=sys.stderr,
        )
        return 3

    run(["git", "push", "-u", "origin", branch])

    pr = subprocess.run(
        ["gh", "pr", "view", "--json", "number", "--jq", ".number"],
        cwd=ROOT,
        text=True,
        capture_output=True,
    )
    if pr.returncode != 0 or not pr.stdout.strip():
        title = git("log", "-1", "--format=%s", capture=True).stdout.strip()
        create = ["gh", "pr", "create", "--fill", "--title", title, "--head", branch]
        # Back pressure (ci/backpressure.py): while the merge queue lands fewer
        # PRs than are in flight, or runners are starved, a new PR opens as a
        # draft, so the work is published but takes no queue capacity. Mark it
        # ready once the gate reads open again.
        gate = subprocess.run(
            ["uv", "run", "--no-project", "--script", str(ROOT / "ci" / "backpressure.py"), "--check"],
            cwd=ROOT, text=True, capture_output=True,
        )
        if gate.returncode == 75:
            print(f"./push: {gate.stdout.strip()}; opening the PR as a draft")
            create.append("--draft")
        run(create)
    else:
        print(f"./push: PR #{pr.stdout.strip()} already exists for {branch}")

    if not attested:
        print(
            "./push: pushed without client attestation. The local gate still stamps the "
            "commit (`ci-lint local-gate run`); run it and push again if CI asks for it."
        )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
